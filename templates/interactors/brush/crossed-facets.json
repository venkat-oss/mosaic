{
  "data": {
    "brush_rows": {
      "type": "table",
      "query": "SELECT * FROM (VALUES (1,2,'A','U'),(3,4,'B','V'),(5,6,'A','U')) AS t(x,y,category,bucket)"
    }
  },
  "params": {
    "selection": {
      "select": "crossfilter"
    }
  },
  "hconcat": [
    {
      "plot": [
        {
          "mark": "dot",
          "data": {
            "from": "brush_rows",
            "filterBy": "$selection"
          },
          "x": "x",
          "y": "y",
          "z": "category",
          "fill": "category",
          "fx": "category",
          "fy": "bucket"
        },
        {
          "select": "intervalX",
          "as": "$selection"
        }
      ],
      "width": 360,
      "height": 260
    },
    {
      "plot": [
        {
          "mark": "dot",
          "data": {
            "from": "brush_rows",
            "filterBy": "$selection"
          },
          "x": "x",
          "y": "y",
          "fill": "category"
        }
      ],
      "width": 360,
      "height": 260
    }
  ]
}
