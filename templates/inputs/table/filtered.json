{
  "data": {
    "table_data": {
      "type": "table",
      "query": "SELECT * FROM (VALUES (1,'A'),(2,'B'),(3,'A'),(4,'B'),(5,'A')) AS t(x,category)"
    }
  },
  "params": {
    "upstream": {
      "select": "intersect"
    }
  },
  "vconcat": [
    {
      "input": "menu",
      "as": "$upstream",
      "field": "category",
      "options": [
        "A",
        "B"
      ]
    },
    {
      "input": "table",
      "from": "table_data",
      "columns": [
        "x",
        "category"
      ],
      "filterBy": "$upstream",
      "rowBatch": 2
    }
  ]
}
