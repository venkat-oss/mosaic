{
  "name": "@uwdata/mosaic-spec",
  "version": "0.34.0",
  "description": "Declarative specification of Mosaic-powered applications.",
  "keywords": [
    "mosaic",
    "visualization",
    "dashboard",
    "declarative",
    "specification"
  ],
  "license": "BSD-3-Clause",
  "author": "Jeffrey Heer (https://idl.uw.edu)",
  "type": "module",
  "exports": {
    "types": "./dist/src/index.d.ts",
    "default": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uwdata/mosaic.git"
  },
  "scripts": {
    "build": "bazelisk build //packages/vgplot/spec:tarball",
    "lint": "bazelisk test //packages/vgplot/spec:lint",
    "typecheck": "bazelisk test //packages/vgplot/spec:test_types_typecheck_test",
    "schema": "bazelisk build //packages/vgplot/spec:schema",
    "test": "bazelisk test //packages/vgplot/spec:check",
    "test:visual": "../../../bin/visual-test.sh",
    "test:visual:update": "../../../bin/visual-test.sh --update",
    "version": "cd ../../.. && pnpm run docs:schema"
  },
  "dependencies": {
    "@uwdata/mosaic-core": "workspace:^",
    "@uwdata/mosaic-sql": "workspace:^",
    "@uwdata/vgplot": "workspace:^"
  }
}
