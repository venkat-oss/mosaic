load("@aspect_rules_js//js:defs.bzl", "js_run_binary", "js_library", "js_test")
load("@mosaic_browser//:defs.bzl", "PLAYWRIGHT_IMAGE")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/vgplot/widget:esbuild/package_json.bzl", esbuild_bin = "bin")
load("//build/python:widget.bzl", "mosaic_widget_python")
load("@rules_python//python:py_binary.bzl", "py_binary")

npm_link_all_packages(name = "node_modules")

js_library(
    name = "manifest",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
)

esbuild_bin.esbuild_binary(name = "esbuild")

js_run_binary(
    name = "bundle",
    tool = ":esbuild",
    chdir = "packages/vgplot/widget",
    srcs = glob(["src/**"]) + [
        ":node_modules/@polyglot-sql/sdk",
        ":node_modules/@uwdata/mosaic-core",
        ":node_modules/@uwdata/mosaic-spec",
        ":node_modules/@uwdata/mosaic-sql",
        ":node_modules/uuid",
    ],
    args = [
        "src/index.js",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--conditions=mosaic-widget",
        "--loader:.wasm=dataurl",
        "--outfile=mosaic_widget/static/index.js",
    ],
    outs = [
        "mosaic_widget/static/index.js",
        "mosaic_widget/static/index.css",
    ],
    visibility = ["//visibility:public"],
)

mosaic_widget_python(bundle = ":bundle")

py_binary(
    name = "wheel_browser_asset_extractor",
    testonly = True,
    srcs = ["test/wheel_asset.py"],
    main = "test/wheel_asset.py",
)

genrule(
    name = "wheel_browser_asset",
    testonly = True,
    srcs = [":wheel"],
    outs = ["wheel-browser.js"],
    cmd = "$(execpath :wheel_browser_asset_extractor) $(location :wheel) $@",
    tools = [":wheel_browser_asset_extractor"],
)

js_run_binary(
    name = "compiler_browser_bundle",
    testonly = True,
    tool = ":esbuild",
    chdir = "packages/vgplot/widget",
    srcs = [
        "test/compiler-entry.js",
        "src/compiler.js",
        ":node_modules/@polyglot-sql/sdk",
        ":node_modules/@uwdata/mosaic-sql",
    ],
    args = [
        "test/compiler-entry.js",
        "--bundle",
        "--format=esm",
        "--target=es2022",
        "--conditions=mosaic-widget",
        "--loader:.wasm=dataurl",
        "--outfile=compiler-browser.js",
    ],
    outs = ["compiler-browser.js"],
)

js_test(
    name = "browser_tests",
    size = "large",
    timeout = "long",
    entry_point = "browser-tests.mjs",
    args = [
        "$(rlocationpath :wheel-browser.js)",
        "$(rlocationpath :compiler-browser.js)",
    ],
    data = [":wheel-browser.js", ":compiler-browser.js", "test/render.js", "//:node_modules/@playwright/test", "//packages/server/duckdb:sources"],
    env = {"PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"},
    exec_properties = {"container-image": "docker://" + PLAYWRIGHT_IMAGE},
    tags = ["requires-browser", "requires-network"],
    visibility = ["//visibility:public"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_project(
    name = "javascript_types",
    visibility = ["//:__pkg__"],
    srcs = ["package.json"] + glob(["src/**/*.js", "src/**/*.d.ts"]),
    tsconfig = {"references": [], "compilerOptions": {"composite": False, "incremental": False}},
    extends = ":tsconfig",
    allow_js = True,
    no_emit = True,
    declaration = True,
    declaration_map = True,
    source_map = True,
    root_dir = ".",
    tsc = "//:tsc",
    supports_workers = 0,
    deps = [":node_modules/@polyglot-sql/sdk", ":node_modules/@uwdata/mosaic-core", ":node_modules/@uwdata/mosaic-spec", ":node_modules/@uwdata/mosaic-sql", ":node_modules/anywidget", ":node_modules/uuid"],
)

js_library(
    name = "lint_sources",
    srcs = glob(["src/**"]),
    deps = ["//:javascript_test_support"],
    testonly = True,
)

eslint_bin.eslint_test(
    name = "javascript_lint",
    visibility = ["//:__pkg__"],
    args = ["src"],
    chdir = "packages/vgplot/widget",
    data = [":lint_sources"],
)

test_suite(
    name = "check",
    tests = [":python_check", ":javascript_types_typecheck_test", ":javascript_lint"],
    visibility = ["//visibility:public"],
)
