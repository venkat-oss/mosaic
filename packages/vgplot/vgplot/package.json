{
  "name": "@uwdata/vgplot",
  "version": "0.34.0",
  "description": "An API for interactive Mosaic-powered visualizations and dashboards.",
  "keywords": [
    "data",
    "visualization",
    "interaction",
    "query",
    "database",
    "duckdb",
    "mosaic"
  ],
  "license": "BSD-3-Clause",
  "author": "Jeffrey Heer (https://idl.uw.edu)",
  "type": "module",
  "exports": {
    "types": "./dist/src/index.d.ts",
    "default": "./src/index.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uwdata/mosaic.git"
  },
  "scripts": {
    "build": "bazelisk build //packages/vgplot/vgplot:tarball",
    "lint": "bazelisk test //packages/vgplot/vgplot:lint",
    "typecheck": "bazelisk test //packages/vgplot/vgplot:test_types_typecheck_test",
    "test": "bazelisk test //packages/vgplot/vgplot:check"
  },
  "dependencies": {
    "@uwdata/mosaic-core": "workspace:^",
    "@uwdata/mosaic-inputs": "workspace:^",
    "@uwdata/mosaic-plot": "workspace:^",
    "@uwdata/mosaic-sql": "workspace:^"
  }
}
