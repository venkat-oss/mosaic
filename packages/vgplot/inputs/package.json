{
  "name": "@uwdata/mosaic-inputs",
  "version": "0.34.0",
  "description": "Mosaic input components.",
  "keywords": [
    "inputs",
    "mosaic"
  ],
  "license": "BSD-3-Clause",
  "author": "Jeffrey Heer (https://idl.uw.edu)",
  "type": "module",
  "exports": {
    "types": "./dist/src/index.d.ts",
    "default": "./src/index.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uwdata/mosaic.git"
  },
  "scripts": {
    "build": "bazelisk build //packages/vgplot/inputs:tarball",
    "lint": "bazelisk test //packages/vgplot/inputs:lint",
    "typecheck": "bazelisk test //packages/vgplot/inputs:test_types_typecheck_test",
    "test": "bazelisk test //packages/vgplot/inputs:check"
  },
  "dependencies": {
    "@uwdata/flechette": "catalog:",
    "@uwdata/mosaic-core": "workspace:^",
    "@uwdata/mosaic-sql": "workspace:^"
  }
}
