{
  "name": "@uwdata/mosaic-sql",
  "version": "0.34.0",
  "description": "SQL query construction and analysis.",
  "keywords": [
    "sql",
    "query",
    "mosaic"
  ],
  "license": "BSD-3-Clause",
  "author": "Jeffrey Heer (https://idl.uw.edu)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./native": {
      "types": "./dist/src/native/index.d.ts",
      "default": "./dist/src/native/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uwdata/mosaic.git"
  },
  "scripts": {
    "build": "bazelisk build //packages/mosaic/sql:tarball",
    "lint": "bazelisk test //packages/mosaic/sql:lint",
    "typecheck": "bazelisk test //packages/mosaic/sql:test_types_typecheck_test",
    "test": "bazelisk test //packages/mosaic/sql:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@uwdata/mosaic-duckdb": "workspace:^"
  },
  "imports": {
    "#polyglot": {
      "mosaic-widget": "@polyglot-sql/sdk/manual",
      "default": "@polyglot-sql/sdk"
    }
  },
  "dependencies": {
    "@polyglot-sql/sdk": "https://github.com/venkat-oss/mosaic/releases/download/polyglot-sdk-d75e21fccecd6d7362b263055d957ee711d318c9/polyglot-sql-sdk-0.13.3-d75e21fccecd6d7362b263055d957ee711d318c9.tgz"
  }
}
