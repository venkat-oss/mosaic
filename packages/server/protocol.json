{
  "commands": [
    {
      "name": "arrow",
      "description": "Execute exactly one SQL statement and return an Arrow IPC stream. A trailing semicolon is allowed. A zero-row result retains its schema and end-of-stream marker."
    },
    {
      "name": "exec",
      "description": "Execute one or more statements in order on one connection and return an empty HTTP 200 response. The server does not retry or promise rollback of earlier effects."
    },
    {
      "name": "preagg",
      "description": "Atomically materialize one read-only SELECT, VALUES, set operation or CTE. Return a fully qualified table reference and an RFC 3339 createdAt timestamp. Reusing a table preserves its timestamp; rebuilding after a drop changes it."
    }
  ],
  "errors": [
    {
      "code": "bad_request",
      "status": 400,
      "reasons": [
        "malformed_json",
        "missing_field",
        "invalid_field",
        "sql_parse_error",
        "multiple_statements",
        "not_read_only",
        "unsupported_statement",
        "method_not_allowed",
        "payload_too_large",
        "unsupported_media_type",
        "precondition_failed"
      ]
    },
    {
      "code": "unauthenticated",
      "status": 401,
      "reasons": [
        "authentication_required",
        "authentication_failed"
      ]
    },
    {
      "code": "forbidden",
      "status": 403,
      "reasons": [
        "policy_denied",
        "access_denied"
      ]
    },
    {
      "code": "table_not_found",
      "status": 404,
      "reasons": [
        "materialization_missing"
      ]
    },
    {
      "code": "unsupported_command",
      "status": 400,
      "reasons": [
        "command_disabled"
      ]
    },
    {
      "code": "resource_exhausted",
      "status": 429,
      "reasons": [
        "resource_limit_exceeded"
      ]
    },
    {
      "code": "deadline_exceeded",
      "status": 504,
      "reasons": [
        "command_deadline_exceeded"
      ]
    },
    {
      "code": "internal_error",
      "status": 500,
      "reasons": [
        "execution_failed",
        "validation_failed",
        "invalid_server_configuration",
        "internal_failure"
      ]
    }
  ],
  "methods": [
    "GET",
    "POST",
    "OPTIONS"
  ],
  "arrowMediaType": "application/vnd.apache.arrow.stream",
  "minimumRequestBytes": 1048576,
  "invalidRequests": [
    {
      "body": {
        "sql": "SELECT 1"
      },
      "reason": "missing_field",
      "field": "type"
    },
    {
      "body": {
        "type": "arrow"
      },
      "reason": "missing_field",
      "field": "sql"
    },
    {
      "body": {
        "type": null,
        "sql": "SELECT 1"
      },
      "reason": "invalid_field",
      "field": "type"
    },
    {
      "body": {
        "type": 1,
        "sql": "SELECT 1"
      },
      "reason": "invalid_field",
      "field": "type"
    },
    {
      "body": {
        "type": true,
        "sql": "SELECT 1"
      },
      "reason": "invalid_field",
      "field": "type"
    },
    {
      "body": {
        "type": "",
        "sql": "SELECT 1"
      },
      "reason": "invalid_field",
      "field": "type"
    },
    {
      "body": {
        "type": "csv",
        "sql": "SELECT 1"
      },
      "reason": "invalid_field",
      "field": "type"
    },
    {
      "body": {
        "type": "ARROW",
        "sql": "SELECT 1"
      },
      "reason": "invalid_field",
      "field": "type"
    },
    {
      "body": {
        "type": "arrow",
        "sql": null
      },
      "reason": "invalid_field",
      "field": "sql"
    },
    {
      "body": {
        "type": "arrow",
        "sql": 1
      },
      "reason": "invalid_field",
      "field": "sql"
    },
    {
      "body": {
        "type": "arrow",
        "sql": true
      },
      "reason": "invalid_field",
      "field": "sql"
    },
    {
      "body": {
        "type": "arrow",
        "sql": ""
      },
      "reason": "invalid_field",
      "field": "sql"
    },
    {
      "body": {
        "type": "arrow",
        "sql": " \t\n"
      },
      "reason": "invalid_field",
      "field": "sql"
    }
  ]
}
