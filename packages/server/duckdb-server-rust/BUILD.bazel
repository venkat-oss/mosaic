load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy", "rust_library", "rust_test", "rustfmt_test")
load("@rust_crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

cargo_toml_env_vars(
    name = "cargo_env",
    src = "Cargo.toml",
)

rust_library(
    name = "duckdb_server",
    srcs = glob(
        ["src/*.rs"],
        exclude = [
            "src/main.rs",
            "src/https.rs",
            "src/test.rs",
        ],
    ),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "duckdb-server",
    srcs = glob(
        ["src/*.rs"],
        exclude = ["src/lib.rs"],
    ),
    aliases = aliases(),
    crate_name = "duckdb_server",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "server_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":duckdb-server",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_binary(
    name = "benchmark",
    srcs = ["benches/benchmark.rs"],
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_root = "benches/benchmark.rs",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env_files = [":cargo_env"],
    visibility = ["//visibility:public"],
    deps = [":duckdb_server"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":benchmark",
        ":duckdb-server",
        ":duckdb_server",
        ":server_test",
    ],
    visibility = ["//visibility:public"],
)

rustfmt_test(
    name = "format_test",
    size = "small",
    targets = [
        ":duckdb-server",
        ":duckdb_server",
        ":benchmark",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":format_test",
        ":server_test",
    ],
    visibility = ["//visibility:public"],
)
