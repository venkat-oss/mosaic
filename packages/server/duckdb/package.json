{
  "name": "@uwdata/mosaic-duckdb",
  "version": "0.34.0",
  "description": "A Promise-based DuckDB API and Node.js data server.",
  "keywords": [
    "duckdb",
    "server",
    "node",
    "arrow",
    "mosaic"
  ],
  "license": "BSD-3-Clause",
  "author": "Jeffrey Heer (https://idl.uw.edu)",
  "type": "module",
  "exports": {
    "types": "./dist/src/index.d.ts",
    "default": "./src/index.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uwdata/mosaic.git"
  },
  "bin": {
    "to-arrow": "./bin/to-arrow.js",
    "to-csv": "./bin/to-csv.js",
    "to-parquet": "./bin/to-parquet.js"
  },
  "scripts": {
    "build": "bazelisk build //packages/server/duckdb:tarball",
    "lint": "bazelisk test //packages/server/duckdb:lint",
    "typecheck": "bazelisk test //packages/server/duckdb:test_types_typecheck_test",
    "server": "bazelisk run //packages/server/duckdb:server --",
    "test": "bazelisk test //packages/server/duckdb:check"
  },
  "dependencies": {
    "@duckdb/node-api": "~2.0.0-r.1",
    "@uwdata/flechette": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
