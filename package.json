{
  "private": true,
  "name": "mosaic",
  "description": "Scalable and extensible linked data views.",
  "license": "BSD-3-Clause",
  "author": "Jeffrey Heer (https://idl.uw.edu)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/uwdata/mosaic.git"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "mkcert": "node bin/mkcert.js",
    "preinstall": "npx only-allow pnpm",
    "docs:dev": "bazelisk run //docs:dev",
    "docs:build": "bazelisk build //docs:site",
    "docs:examples": "bazelisk run //:examples",
    "docs:preview": "bazelisk run //docs:preview",
    "docs:schema": "node bin/publish-schema.js && bin/push-schema.sh",
    "generate:api": "bazelisk run //:generate",
    "check:api": "bazelisk test //:api_check",
    "test:api": "bazelisk test //bin/test:tests",
    "generate:python-api": "pnpm generate:api",
    "build": "bazelisk build //:build",
    "clean": "bazelisk clean",
    "lint": "bazelisk test //:lint //packages/server/duckdb-server-rust:clippy",
    "lint:fix": "bazelisk run //:lint_fix",
    "typecheck": "bazelisk test //:typecheck",
    "test": "bazelisk test //:check",
    "server": "bazelisk run //packages/server/duckdb-server:dev --",
    "server:rust": "bazelisk run //packages/server/duckdb-server-rust:duckdb-server --",
    "server:go": "bazelisk run //packages/server/duckdb-server-go:duckdb-server --",
    "server:node": "bazelisk run //packages/server/duckdb:server --",
    "dev": "bazelisk run //:dev",
    "version": "bazelisk mod deps && git add MODULE.bazel.lock"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@polyglot-sql/sdk": "https://github.com/venkat-oss/mosaic/releases/download/polyglot-sdk-7cfdd78107ee2bcfccaa0ce0dbe1b7269ac396e0/polyglot-sql-sdk-0.13.3-7cfdd78107ee2bcfccaa0ce0dbe1b7269ac396e0.tgz",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@uwdata/mosaic-core": "workspace:*",
    "@uwdata/mosaic-plot": "workspace:*",
    "@uwdata/mosaic-spec": "workspace:*",
    "@uwdata/mosaic-sql": "workspace:*",
    "@uwdata/vgplot": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "d3": "^7.9.0",
    "embedding-atlas": "0.26.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lerna": "^10.1.1",
    "timezone-mock": "^1.4.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitepress": "~1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.0.5",
    "vue": "3.5.27",
    "yaml": "^2.9.1"
  }
}
