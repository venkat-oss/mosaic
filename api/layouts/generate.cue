package layouts

import (
	"encoding/json"
	"strings"
	"idl.uw.edu/mosaic/api/render"
)

let Contracts = contracts
let ExternalReferences = externalReferences
_shape: render.#ShapeProjection & {expressions: typeExpressions, contracts: Contracts, externalReferences: ExternalReferences}
shapeChecks: _shape.checks
nativeDefinitions: json.Unmarshal(json.Marshal({for name, projection in _shape.contractProjections {(name): projection.native}}))
schemaFragment: definitions: {for contract in contracts {(contract.name): _shape.contractProjections[contract.name].schema}}
sections: []
_header: "Generated by pnpm generate:api from api/layouts. DO NOT EDIT."
_typeFiles: {
	for layout in layouts {
		"packages/vgplot/spec/src/spec/\(layout.type).ts": "// \(_header)\n" + strings.Join([if layout.kind == "concat" {"import { Component } from './Spec.js';\n"}], "") + _shape.contractProjections[layout.type].declaration
	}
	"packages/vgplot/spec/src/generated/layouts.cue": "// \(_header)\npackage layoutadmission\n\n" + strings.Join([for layout in layouts if layout.kind == "space" {"#\(layout.type): \(nativeDefinitions[layout.type])\n"}], "\n")
	"packages/vgplot/spec/src/generated/layouts.js": "// \(_header)\n" + strings.Join([for layout in layouts {"export const \(layout.constant) = \((render.#TypeScriptLiteral & {value: layout.name}).text);"}], "\n") + "\n\nexport const LAYOUT_APIS = [\n" + strings.Join([for layout in codegenLayouts {"  { key: \((render.#TypeScriptLiteral & {value: layout.name}).text), kind: \((render.#TypeScriptLiteral & {value: layout.kind}).text), python: \((render.#TypeScriptLiteral & {value: layout.name}).text) },"}], "\n") + "\n];\n"
	"packages/vgplot/spec/src/generated/layout-components.js": "// \(_header)\n" + strings.Join([for layout in layouts {"import { parse\(layout.type) } from '../ast/\(layout.type)Node.js';"}], "\n") + "\n\nexport const LAYOUT_COMPONENTS = [\n" + strings.Join([for layout in parserLayouts {"  [\((render.#TypeScriptLiteral & {value: layout.name}).text), parse\(layout.type)],"}], "\n") + "\n];\n"
}
_jsFiles: {
	"packages/vgplot/vgplot/src/layout/defaults.js": "// \(_header)\nexport const DEFAULT_SPACE_SIZE = \(layoutIndex.hspace.jsDefault);\n"
	for kind in ["concat", "space"] {
		"packages/vgplot/vgplot/src/layout/\(kind).js": "// \(_header)\nimport { \(kind) } from './runtime.js';\nexport { \(kind) } from './runtime.js';\n\n" + strings.Join([for layout in layouts if layout.kind == kind {
			if kind == "concat" {"export function \(layout.name)(...plots) {\n  return concat({ direction: \((render.#TypeScriptLiteral & {value: layout.direction}).text) }, plots.flat(\(layout.jsFlatten)));\n}\n"}
			if kind == "space" {"export function \(layout.name)(size) {\n  return space({ dim: \((render.#TypeScriptLiteral & {value: layout.dimension}).text), size });\n}\n"}
		}], "\n")
	}
}
files: {
	for path, content in _typeFiles {(path): content}
	for path, content in _jsFiles {(path): content}
	for path, content in pythonFiles {(path): content}
	for path, content in docFiles {(path): content}
	for path, content in templateFiles {(path): content}
}
nativeChecks: [{files: {
	"contracts.cue": _typeFiles["packages/vgplot/spec/src/generated/layouts.cue"]
	"examples.cue": "package layoutadmission\n" + strings.Join([for item in layoutExamples {"\(json.Marshal(item.name)): #HSpace & {hspace: \(json.Marshal(item.gap))}\n"}], "\n")
}}]

nativeObjects: _shape.nativeObjects

admissionDefinitions: _shape.admissionDefinitions
