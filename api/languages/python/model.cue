package python

import (
	"list"
	"regexp"
	"strings"
	"idl.uw.edu/mosaic/api/model"
	"idl.uw.edu/mosaic/api/render"
)

keywords: [...model.#Name] & ["False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "type", "while", "with", "yield"]
keywordChecks: unique: true & list.UniqueItems(keywords)
#Identifier: {
	wire!:  model.#Name
	_snake: strings.ToLower(regexp.ReplaceAll("([a-z0-9])([A-Z])", wire, "${1}_${2}"))
	name: _snake + strings.Join([if list.Contains(keywords, _snake) {"_"}], "")
}
files: {
	"packages/vgplot/spec/src/python-keywords.js": "// Generated by pnpm generate:api from api/languages/python. DO NOT EDIT.\nexport const PYTHON_KEYWORDS = new Set([\n" + strings.Join([for keyword in keywords {"  " + (render.#TypeScriptLiteral & {value: keyword}).text + ","}], "\n") + "\n]);\n"
}
