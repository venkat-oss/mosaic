package attributerender

import (
	"encoding/json"
	"list"
	"regexp"
	"strings"
	attributeModel "idl.uw.edu/mosaic/api/attributes"
	"idl.uw.edu/mosaic/api/model"
	baseRender "idl.uw.edu/mosaic/api/render"
)

#FamilyIdentity: {
	slug!:       "cartesian" | "facet" | "color" | "size" | "projection"
	helperName!: model.#Name
}
#ReferenceGroup: {
	id!:    model.#Name
	title!: string & !=""
	attributes!: [model.#Name, ...model.#Name]
	sections!: {js!: string & !="", python!: string & !=""}
	trailing: *"" | string
}
#ReferenceNote: {
	attributes!: [model.#Name, ...model.#Name]
	text!: string & !=""
}
#PythonDescription: {
	description!: string
	_linked:      regexp.ReplaceAll(#"\[([^\]]+)\]\([^)]*\)"#, description, "${1}")
	_references:  regexp.ReplaceAll(#"\[([^\]]+)\]\[[^\]]*\]"#, _linked, "${1}")
	_footnotes:   regexp.ReplaceAll(#"\[[0-9]+\]"#, _references, "")
	_bare:        regexp.ReplaceAll(#"\[([^\]]+)\]"#, _footnotes, "${1}")
	_flat:        strings.TrimSpace(regexp.ReplaceAll(#"\s+"#, _bare, " "))
	text:         strings.TrimSpace(strings.SplitAfter(_flat, ". ")[0])
}
#JSAttributeWrapper: {
	attribute!: attributeModel.#Attribute & {jsKind: "simple" | "paired", python: kind: "value"}
	let A = attribute
	text: string
	if A.jsKind == "simple" {text: "\nexport const \(A.name) = attrf(\((baseRender.#TypeScriptLiteral & {value: A.name}).text));"}
	if A.jsKind == "paired" {text: "\n\nexport function \(A.name)(value) {\n  return attributes({ \(strings.Join([for target in A.targets {"\(target): value"}], ", ")) });\n}"}
}
#AttributeFamilyProjection: {
	identity!: #FamilyIdentity
	attributes!: [attributeModel.#Attribute & {jsKind: "simple" | "paired", python: kind: "value", route: kind: "mapped" | "wrapper-only"}, ...attributeModel.#Attribute & {jsKind: "simple" | "paired", python: kind: "value", route: kind: "mapped" | "wrapper-only"}]
	typeExpressions!: [string]: model.#ShapeExpression
	contracts!: [...model.#ShapeContract]
	externalReferences!: [...model.#ExternalReference]
	nativeReferences!: [model.#Name]: string & !=""
	aliasSections: *[] | [...{name!: model.#Name, id!: string & !=""}]
	referenceGroups!: [#ReferenceGroup, ...#ReferenceGroup]
	referenceNotes: *[] | [...#ReferenceNote]
	let I = identity
	let Attributes = attributes
	let Expressions = typeExpressions
	let Contracts = contracts
	let ExternalReferences = externalReferences
	let NativeReferences = nativeReferences
	let Groups = referenceGroups
	let Notes = referenceNotes
	_header:        "Generated by pnpm generate:api from api/attributes/\(I.slug). DO NOT EDIT."
	_pythonModule:  "\(I.slug)_attributes"
	_stem:          "\(I.slug)-attributes"
	_routeConstant: "\(strings.ToUpper(I.slug))_ATTRIBUTE_ROUTES"
	_shape: baseRender.#ShapeProjection & {expressions: Expressions, contracts: Contracts, externalReferences: ExternalReferences}
	attributeIndex: {for A in Attributes {(A.name): A}}
	let Index = attributeIndex
	propertyProjections: {for A in Attributes {
		(A.name): {
			typescript: _shape.projections[A.type].typescript
			native:     _shape.projections[A.type].native
			schema: _shape.projections[A.type].schema & {description: A.description}
			declaration: "\n\n" + (baseRender.#ShapeDescription & {description: A.description, prefix: "  "}).text + "  \(A.name)?: \(_shape.projections[A.type].typescript);"
		}
	}}
	schemaFragment: {
		definitions: {for Contract in Contracts if Contract.wire {(Contract.name): _shape.contractProjections[Contract.name].schema}}
		properties: [for DefinitionName in ["Plot", "PlotAttributes"] {
			definition: DefinitionName
			values: {for A in Attributes {(A.name): propertyProjections[A.name].schema}}
		}]
	}
	sharedTypeImports: [{path: "packages/vgplot/spec/src/spec/PlotAttribute.ts", imports: ExternalReferences}]
	admissionDefinitions: _shape.admissionDefinitions
	nativeDefinitions: json.Unmarshal(json.Marshal({for name, projection in _shape.contractProjections {(name): projection.native}}))
	nativeSource: "// \(_header)\npackage \(I.slug)attributeadmission\n\n" + strings.Join([for name, definition in NativeReferences {"#\(name): \(definition)\n"}, for name, definition in nativeDefinitions {"#\(name): \(definition)\n"}], "\n")
	routeRecords: [for Order in list.Sort([for A in Attributes if A.route.kind == "mapped" {A.route.order}], list.Ascending) for A in Attributes if A.route.kind == "mapped" if A.route.order == Order {{key: A.name, path: A.route.path}}]
	pythonSymbols: [for A in Attributes {{key: A.name, name: A.python.name, module: _pythonModule}}]
	_pythonFunctions: [for A in Attributes {"def \(A.python.name)(value: AttrValue\(strings.Join([if A.python.default == "true" {" = True"}], ""))) -> Directive:\n    \(json.Marshal((#PythonDescription & {description: A.description}).text))\n    from ..plot import Directive\n\n    return Directive(\(json.Marshal(A.name)), value)\n"}]
	_pythonSource: """
  # \(_header)
  from __future__ import annotations

  from typing import TYPE_CHECKING

  if TYPE_CHECKING:
      from .._types import AttrValue
      from ..plot import Directive


  \(strings.Join(_pythonFunctions, "\n\n"))

  \(strings.Join([for A in Attributes {"\(A.python.name).__module__ = \"vgplot._generated.attributes\""}], "\n"))
  """
	_referenceMethods: {for Language in ["js", "python"] {
		(Language): {for A in Attributes {
			let Signature = {js: "\(A.name)(value)", python: "vg.\(A.python.name)(value\(strings.Join([if A.python.default == "true" {"=True"}], "")))"}[Language]
			(A.name): "| [`\(Signature)`](#\(strings.ToLower(A.name))) | `` " + strings.Replace(_shape.projections[A.type].typescript, "|", "\\|", -1) + " `` |"
		}}
	}}
	_referenceSections: list.Concat([for Language in ["js", "python"] {
		let SectionIds = [for Group in Groups {Group.sections[Language]}]
		[for i, Id in SectionIds if !list.Contains(list.Take(SectionIds, i), Id) {
			id:       Id
			language: Language
			text: "\n" + strings.Join([for Group in Groups if Group.sections[Language] == Id {"## \(Group.title)\n\n| Directive | Value type |\n| --- | --- |\n" + strings.Join([for Name in Group.attributes {_referenceMethods[Language][Name]}], "\n")}], "\n") + "\n"
		}]
	}])
	_referenceDescription: "\n## \(I.slug) attribute reference\n\n" + strings.Join([for i, A in Attributes if !list.Contains([for Prior in list.Take(Attributes, i) {Prior.description}], A.description) {
		let Names = [for Other in Attributes if Other.description == A.description {Other.name}]
		"### \(A.name)\n\n" + strings.Join([for Name in Names if Name != A.name {"<span id=\"\(strings.ToLower(Name))\"></span>\n"}], "") + strings.Join([if len(Names) > 1 {"Applies to " + strings.Join([for Name in Names {"`" + Name + "`"}], ", ") + ".\n\n"}], "") + (baseRender.#MarkdownReferences & {value: A.description}).text + "\n"
	}], "\n") + "\n" + strings.Join([for Note in Notes {"**" + strings.Join([for Name in Note.attributes {"`" + Name + "`"}], ", ") + ":** " + Note.text + "\n"}], "\n") + strings.Join([for i, Group in Groups if Group.trailing != "" if !list.Contains([for Prior in list.Take(Groups, i) {Prior.trailing}], Group.trailing) {Group.trailing}], "\n")
	sections: [
		{path: "docs/api/vgplot/attributes.md", id: "reference-\(I.slug)", owner: I.slug, text: _referenceDescription},
		for A in Attributes {{path: "packages/vgplot/spec/src/spec/PlotAttribute.ts", id: A.tsSection, owner: I.slug, text: propertyProjections[A.name].declaration}},
		for A in Attributes {{path: "packages/vgplot/vgplot/src/plot/attributes.js", id: A.jsSection, owner: I.slug, text: (#JSAttributeWrapper & {attribute: A}).text}},
		for Alias in aliasSections {{path: "packages/vgplot/spec/src/spec/PlotAttribute.ts", id: Alias.id, owner: I.slug, placement: "declaration", text: (baseRender.#DeclarationSection & {declaration: _shape.contractProjections[Alias.name].declaration}).text}},
		for Section in _referenceSections {{path: "docs/api/vgplot/attributes.md", id: Section.id, owner: I.slug, language: Section.language, text: Section.text}},
	]
	files: {
		"packages/vgplot/spec/src/generated/\(_stem).cue": nativeSource
		"packages/vgplot/plot/src/generated/\(I.slug)-attribute-routes.js": "// \(_header)\n/** @type {[string, string][]} */\nexport const \(_routeConstant) = [\n" + strings.Join([for Route in routeRecords {"  [\((baseRender.#TypeScriptLiteral & {value: Route.key}).text), \((baseRender.#TypeScriptLiteral & {value: Route.path}).text)],"}], "\n") + "\n];\n"
		"packages/vgplot/vgplot-python/vgplot/_generated/\(_pythonModule).py": _pythonSource
	}
	checks: {
		shape: _shape.checks
		names: true & list.UniqueItems([for A in Attributes {A.name}])
		pythonNames: true & list.UniqueItems([for A in Attributes {A.python.name}])
		tsSections: true & list.UniqueItems(list.Concat([[for A in Attributes {A.tsSection}], [for Alias in aliasSections {Alias.id}]]))
		jsSections: true & list.UniqueItems([for A in Attributes {A.jsSection}])
		routeOrders: true & list.UniqueItems([for A in Attributes if A.route.kind == "mapped" {A.route.order}])
		routePaths: true & list.UniqueItems([for A in Attributes if A.route.kind == "mapped" {A.route.path}])
		helper: _shape.contractIndex[I.helperName] & {kind: "interface", wire: false, extends: []}
		helperProperties: true & (list.Sort([for Property in _shape.effectiveProperties[I.helperName] {Property.name}], list.Ascending) == list.Sort([for A in Attributes {A.name}], list.Ascending))
		helperTypes: [for Property in _shape.effectiveProperties[I.helperName] {true & (Property.type == Index[Property.name].type), true & !Property.required, true & (Property.description == Index[Property.name].description)}]
		externalNative: [for Reference in ExternalReferences {NativeReferences[Reference.name]}]
		nativeNames: true & list.UniqueItems(list.Concat([[for Name, _ in NativeReferences {Name}], [for Contract in Contracts {Contract.name}]]))
		pairedTargets: [for A in Attributes if A.jsKind == "paired" {true & (A.route.kind == "wrapper-only"), for Target in A.targets {true & list.Contains([for Item in Attributes {Item.name}], Target)}}]
		docGroupIds: true & list.UniqueItems([for Group in Groups {Group.id}])
		docCoverage: true & (list.Sort(list.Concat([for Group in Groups {Group.attributes}]), list.Ascending) == list.Sort([for A in Attributes {A.name}], list.Ascending))
		docMembers: [for Group in Groups {true & list.UniqueItems(Group.attributes)}]
		noteAttributes: [for Note in Notes for Name in Note.attributes {true & list.Contains([for A in Attributes {A.name}], Name)}]
		aliasNames: true & list.UniqueItems([for Alias in aliasSections {Alias.name}])
		aliasSectionIds: true & list.UniqueItems([for Alias in aliasSections {Alias.id}])
		aliasKinds: [for Alias in aliasSections {_shape.contractIndex[Alias.name] & {kind: "alias", wire: true, exported: true}}]
		aliasCoverage: true & (list.Sort([for Alias in aliasSections {Alias.name}], list.Ascending) == list.Sort([for Contract in Contracts if Contract.wire if Contract.exported {Contract.name}], list.Ascending))
	}
}
