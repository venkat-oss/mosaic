package tableinput

import (
	"encoding/json"
	"list"
	"strings"
)

#PythonParameter: {
	name!:      "source" | "bind" | "columns" | "filter_by" | "width" | "height" | "max_width" | "row_batch" | "align" | "opts"
	annotation: "Any"
	kind:       *"positional-or-keyword" | "keyword-variadic"
	default:    *"none" | "required"
	if kind == "keyword-variadic" {name: "opts", default: "required"}
}
#PythonFactory: {
	name: api.python
	parameters!: [...#PythonParameter]
	_names: true & list.UniqueItems([for parameter in parameters {parameter.name}])
	_order: [for index, Parameter in parameters {
		if Parameter.kind == "keyword-variadic" {true & (index == len(parameters)-1)}
		if Parameter.kind == "positional-or-keyword" {
			true & (len([for earlier, Previous in parameters if earlier < index if Previous.kind == "keyword-variadic" {Previous.name}]) == 0)
			if Parameter.default == "required" {true & (len([for earlier, Previous in parameters if earlier < index if Previous.default != "required" {Previous.name}]) == 0)}
		}
	}]
}
pythonFactory: #PythonFactory & {
	parameters: [
		{name: "source", default: "required"},
		for Name in ["bind", "columns", "filter_by", "width", "height", "max_width", "row_batch", "align"] {{name: Name}},
		{name: "opts", kind: "keyword-variadic"},
	]
}
_pythonParameters: [for parameter in pythonFactory.parameters {
	strings.Join([if parameter.kind == "keyword-variadic" {"**"}], "") + parameter.name + ": " + parameter.annotation + strings.Join([if parameter.default == "none" {" = None"}], "")
}]
pythonFiles: {
	"packages/vgplot/vgplot-python/vgplot/_table_api.py": """
  # Generated by pnpm generate:api from api/inputs/table. DO NOT EDIT.
  from __future__ import annotations

  from typing import TYPE_CHECKING, Any

  from ._input_api import input

  if TYPE_CHECKING:
      from .spec import View


  def \(pythonFactory.name)(\(strings.Join(_pythonParameters, ", "))) -> View:
      return input(\(json.Marshal(api.name)), \(strings.Join([for parameter in pythonFactory.parameters if parameter.kind == "positional-or-keyword" {"\(parameter.name)=\(parameter.name)"}, for parameter in pythonFactory.parameters if parameter.kind == "keyword-variadic" {"**\(parameter.name)"}], ", ")))


  \(pythonFactory.name).__module__ = "vgplot.plot"
  """
}
