package params

import (
	"encoding/json"
	"strings"
	"idl.uw.edu/mosaic/api/render"
)

let Contracts = contracts
_shape: render.#ShapeProjection & {expressions: typeExpressions, contracts: Contracts}
shapeChecks: _shape.checks
nativeDefinitions: json.Unmarshal(json.Marshal({for name, projection in _shape.contractProjections {(name): projection.native}}))
schemaFragment: definitions: {for contract in contracts if contract.wire {(contract.name): _shape.contractProjections[contract.name].schema}}
sections: []
_header: "Generated by pnpm generate:api from api/params. DO NOT EDIT."
_metadataLines: [
	for item in runtimeNames {"export const \(item.name) = \((render.#TypeScriptLiteral & {value: item.value}).text);"},
	"",
	"export const PARAM_TYPES = [\(strings.Join([for item in parserKinds {(render.#TypeScriptLiteral & {value: item}).text}], ", "))];",
	"export const PARAM_DEFAULT = \((render.#TypeScriptLiteral & {value: paramDefault}).text);",
	"export const SELECTION_DEFAULT = \((render.#TypeScriptLiteral & {value: selectionDefaultName}).text);",
	"export const SELECTION_APIS = {",
	for factory in selectionFactories {"  \(factory.wire): { python: \((render.#TypeScriptLiteral & {value: factory.name}).text) },"},
	"};",
	"export const SELECTION_OPTIONS = [\(strings.Join([for property in contractIndex.Selection.properties if property.name != "select" {(render.#TypeScriptLiteral & {value: property.name}).text}], ", "))];",
]

_typeFiles: {
	"packages/vgplot/spec/src/spec/Param.ts": "// \(_header)\n" + strings.Join([for contract in contracts {_shape.contractProjections[contract.name].declaration}], "\n")
	"packages/vgplot/spec/src/generated/params.cue": "// \(_header)\npackage paramadmission\n\n" + strings.Join([for contract in contracts {"#\(contract.name): \(nativeDefinitions[contract.name])\n"}], "\n")
	"packages/vgplot/spec/src/generated/params.js": "// \(_header)\n" + strings.Join(_metadataLines, "\n") + "\n"
}
files: {
	for path, content in _typeFiles {(path): content}
	for path, content in docFiles {(path): content}
	for path, content in templateFiles {(path): content}
	for path, content in pythonFiles {(path): content}
}

nativeObjects: _shape.nativeObjects

admissionDefinitions: _shape.admissionDefinitions
