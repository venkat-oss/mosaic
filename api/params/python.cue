package params

import (
	"encoding/json"
	"list"
	"strings"
)

#PythonFactory: {
	name:         "param"
	description!: string & !=""
	argument: {
		name:    "value"
		type:    "Any"
		default: null
		kind:    "positional-or-keyword"
	}
	returns:          "_ParamBase"
	dispatch:         "list-or-value"
	arrayConstructor: "ParamArray"
	valueConstructor: "ParamValue"
}

pythonFactory: #PythonFactory & {
	description: "Create an array parameter for a Python list, or a scalar parameter for any other value; an omitted value is explicit None."
}

#PythonSelectionNamespace: {
	name:         "selection"
	description!: string & !=""
	argument: {name: "opts", type: "Any", kind: "keyword-variadic"}
	constructor:  "SelectionDef"
	returns:      "SelectionDef"
	optionPolicy: "runtime-omit-none-raw-keys"
}

pythonSelectionNamespace: #PythonSelectionNamespace & {
	description: "Namespace for creating selection params."
}

#PythonRuntimeClass: "_ParamBase" | "ParamValue" | "ParamArray" | "SelectionDef"
#PythonRuntimeExport: {
	name!: "date" | "_resolve"
	kind!: "value" | "function"
	if name == "date" {kind: "value"}
	if name == "_resolve" {kind: "function"}
}

pythonRuntime: {
	module:       "_param_runtime"
	publicModule: "vgplot.params"
	classes: [...#PythonRuntimeClass] & ["_ParamBase", "ParamValue", "ParamArray", "SelectionDef"]
	exports: [...#PythonRuntimeExport] & [{name: "date", kind: "value"}, {name: "_resolve", kind: "function"}]
}

checks: {
	pythonRuntimeClasses: true & list.UniqueItems(pythonRuntime.classes)
	pythonRuntimeExports: true & list.UniqueItems([for item in pythonRuntime.exports {item.name}])
	pythonRuntimeHooks: [for name in [pythonFactory.returns, pythonFactory.arrayConstructor, pythonFactory.valueConstructor, pythonSelectionNamespace.constructor] {
		true & list.Contains(pythonRuntime.classes, name)
	}]
}

_pythonSelectionMethods: [for factory in selectionFactories {
	"""
	    @staticmethod
	    def \(factory.name)(**\(pythonSelectionNamespace.argument.name): \(pythonSelectionNamespace.argument.type)) -> \(pythonSelectionNamespace.returns):
	        return \(pythonSelectionNamespace.constructor)(\(json.Marshal(factory.wire)), **\(pythonSelectionNamespace.argument.name))
	"""
}]

pythonFiles: {
	"packages/vgplot/vgplot-python/vgplot/params.py": """
		# Generated by pnpm generate:api from api/params. DO NOT EDIT.
		from __future__ import annotations

		from typing import Any

		from . import \(pythonRuntime.module)
		from .\(pythonRuntime.module) import \(strings.Join(pythonRuntime.classes, ", "))


		\(strings.Join([for item in pythonRuntime.exports {"\(item.name) = \(pythonRuntime.module).\(item.name)"}], "\n"))

		# Historical pickle references resolve through vgplot.params.
		for _runtime_class in (\(strings.Join(pythonRuntime.classes, ", "))):
		    _runtime_class.__module__ = \(json.Marshal(pythonRuntime.publicModule))
		\(strings.Join([for item in pythonRuntime.exports if item.kind == "function" {"\(item.name).__module__ = \(json.Marshal(pythonRuntime.publicModule))"}], "\n"))


		def \(pythonFactory.name)(\(pythonFactory.argument.name): \(pythonFactory.argument.type) = None) -> \(pythonFactory.returns):
		    if isinstance(\(pythonFactory.argument.name), list):
		        return \(pythonFactory.arrayConstructor)(\(pythonFactory.argument.name))
		    return \(pythonFactory.valueConstructor)(\(pythonFactory.argument.name))


		class \(pythonSelectionNamespace.name):  # ruff: ignore[invalid-class-name]
		    \(json.Marshal(pythonSelectionNamespace.description))

		\(strings.Join(_pythonSelectionMethods, "\n\n"))
		"""
}
