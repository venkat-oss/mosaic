package common

import (
	"encoding/json"
	"strings"
	dataFamily "idl.uw.edu/mosaic/api/data"
	pythonLanguage "idl.uw.edu/mosaic/api/languages/python"
	"idl.uw.edu/mosaic/api/render"
)

dataOptions: [for property in dataFamily.contractIndex.PlotFrom.properties if !property.required {{wire: property.name, python: (pythonLanguage.#Identifier & {wire: property.name}).name, description: property.description}}]
channelsBinding: {option: "channels", argument: "channels", helper: ([for factory in pythonFactories if factory.name == "channels" {factory.name}])[0]}
metadataFiles: {
	"packages/vgplot/vgplot-python/vgplot/_mark_contracts.py": "# Generated by pnpm generate:api from api/marks/common. DO NOT EDIT.\nDATA_OPTIONS = " + json.Marshal({for option in dataOptions {(option.python): option.wire}}) + "\n"
	"packages/vgplot/spec/src/generated/common-marks.js": "// Generated by pnpm generate:api from api/marks/common. DO NOT EDIT.\nexport const MARK_CHANNELS = { " + strings.Join([for key in ["option", "argument", "helper"] {key + ": " + (render.#TypeScriptLiteral & {value: channelsBinding[key]}).text}], ", ") + " };\n"
}
channelsBindingChecks: property: true & (contractIndex.MarkOptions.properties[[for i, property in contractIndex.MarkOptions.properties if property.name == channelsBinding.option {i}][0]].name == channelsBinding.option)
