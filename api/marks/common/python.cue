package common

import (
	"list"
	"encoding/json"
	"strings"
	markProfile "idl.uw.edu/mosaic/api/marks/profile"
)

pythonFactories: [...markProfile.#PythonFactory] & [
	{name: "mark", description: "Create a mark. " + contractIndex.ChannelValueSpec.description},
	{name: "channels", description: contractIndex.ChannelName.description + " Create a channel mapping while preserving the supplied keys."},
	{name: "directive", description: "Create a plot directive with a key and value."},
]
pythonFactoryChecks: {
	names: true & list.UniqueItems([for factory in pythonFactories {factory.name}])
}
pythonFiles: {
	"packages/vgplot/vgplot-python/vgplot/_mark_api.py": """
 # Generated by pnpm generate:api from api/marks/common. DO NOT EDIT.
 from __future__ import annotations

 from typing import TYPE_CHECKING, Any

 from . import _mark_runtime as _runtime

 _RETURN_TYPES = \(json.Marshal([for i, factory in pythonFactories if list.Contains(["Mark", "Directive"], factory.returns) if !list.Contains([for prior in list.Take(pythonFactories, i) if list.Contains(["Mark", "Directive"], prior.returns) {prior.returns}], factory.returns) {factory.returns}]))

 if TYPE_CHECKING:
     from ._types import MarkData
     from .plot import Directive, Mark


 \(strings.Join([for factory in pythonFactories { let Factory = factory
		(markProfile.#PythonFactoryProjection & {factory: Factory}).text
	}], "\n\n\n"))

 """
}
