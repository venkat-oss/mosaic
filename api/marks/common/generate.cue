package common

import (
	canonical "idl.uw.edu/mosaic/api/marks/common/model:commonmodel"
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/render"
	markProfile "idl.uw.edu/mosaic/api/marks/profile"
	pythonLanguage "idl.uw.edu/mosaic/api/languages/python"
)

contracts:          canonical.contracts
typeExpressions:    canonical.typeExpressions
externalReferences: canonical.externalReferences
contractIndex:      canonical.contractIndex
modelChecks:        canonical.modelChecks
modelAdmission:     canonical

let Expressions = typeExpressions
let Contracts = contracts
let External = externalReferences
_shape: render.#ShapeProjection & {expressions: Expressions, contracts: Contracts, externalReferences: External}
shapeChecks: _shape.checks
schemaFragment: definitions: {for contract in contracts if contract.wire {(contract.name): _shape.contractProjections[contract.name].schema}}
nativeDefinitions: {for contract in contracts {(contract.name): _shape.contractProjections[contract.name].native}}
_typeFiles: {
	"packages/vgplot/spec/src/spec/marks/Marks.ts": "// Generated by pnpm generate:api from api/marks/common. DO NOT EDIT.\n\n" + strings.Join([for i, reference in externalReferences if !list.Contains([for prior in list.Take(externalReferences, i) {prior.source}], reference.source) {"import { " + strings.Join([for member in externalReferences if member.source == reference.source {member.name}], ", ") + " } from '" + reference.source + "';"}], "\n") + "\n\n" + strings.Join([for contract in contracts {_shape.contractProjections[contract.name].declaration}], "\n")
}
sections: [
	{path: "docs/api/vgplot/marks.md", id: "js-introduction-2", owner: "common-marks", placement: "introduction", language: "js", text: markIntroductions.javascript},
	{path: "docs/api/vgplot/marks.md", id: "python-introduction-33", owner: "common-marks", placement: "introduction", language: "python", text: markIntroductions.python},
]
files: {
	for path, content in _typeFiles {(path): content}
	for path, content in nativeFiles {(path): content}
	for path, content in metadataFiles {(path): content}
	for path, content in pythonFiles {(path): content}
	for path, content in docFiles {(path): content}
	for path, content in authoringFiles {(path): content}
	for path, content in markProfile.javascriptFiles {(path): content}
	for path, content in pythonLanguage.files {(path): content}
}

nativeObjects: _shape.nativeObjects

admissionDefinitions: _shape.admissionDefinitions
