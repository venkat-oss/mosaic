package common

import (
	"encoding/json"
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/model"
	valueFamily "idl.uw.edu/mosaic/api/values"
	paramFamily "idl.uw.edu/mosaic/api/params"
	dataFamily "idl.uw.edu/mosaic/api/data"
)

bridgeContracts: ["ChannelValue", "ChannelValueSpec", "ChannelValueIntervalSpec", "SortOrder", "MarkOptions", "TextStyles", "TipOptions", "StackOptions"]
standaloneContracts: [for contract in contracts if !list.Contains(bridgeContracts, contract.name) {contract.name}]
nativeDependencies: [
	for dependencyName in ["CurveName", "ScaleName", "Reducer", "ReducerPercentile", "TimeIntervalName"] {{owner: "values", name: dependencyName}},
	{owner: "params", name: "ParamRef"},
	for dependencyName in ["PlotDataInline", "PlotFrom", "PlotMarkData"] {{owner: "data", name: dependencyName}},
]
_nativeDependencyDefinitions: {
	for dependency in nativeDependencies {
		if dependency.owner == "values" {(dependency.name): valueFamily.nativeDefinitions[dependency.name]}
		if dependency.owner == "params" {(dependency.name): paramFamily.nativeDefinitions[dependency.name]}
		if dependency.owner == "data" {(dependency.name): dataFamily.nativeDefinitions[dependency.name]}
	}
}
nativeSamples: [...{contract!: model.#Name, value!: _}] & [
	{contract: "ChannelName", value: "x"},
	{contract: "ChannelScale", value: "color"},
	{contract: "ChannelDomainName", value: "data"},
	{contract: "ChannelDomainValue", value: "-y"},
	{contract: "ChannelDomainOptions", value: {limit: [0, 2], order: null, reduce: "mean"}},
	{contract: "ChannelDomainValueSpec", value: {value: "y", limit: [0, 2], order: null}},
	{contract: "ChannelDomainSort", value: {x: {value: "y", reduce: "sum", order: "descending", limit: [0, 3]}}},
	{contract: "ChannelReducers", value: {x: "mean", y: {reduce: "max", scale: "y"}}},
	{contract: "ChannelStates", value: {x: {value: [1, 2], scale: "x"}}},
	{contract: "ChannelValues", value: {x: [1, 2], channels: {x: {value: [1, 2], scale: "x"}}}},
	{contract: "TipPointer", value: "xy"},
	{contract: "SelectFilter", value: "nearest"},
	{contract: "MarkData", value: {data: [{x: 1}]}},
	{contract: "MarkDataOptional", value: {}},
	{contract: "InsetOptions", value: {inset: 2}},
	{contract: "Curve", value: "linear"},
	{contract: "CurveOptions", value: {curve: "linear"}},
	{contract: "CurveAutoOptions", value: {curve: "auto"}},
	{contract: "StackOffsetName", value: "normalize"},
	{contract: "StackOffset", value: "normalize"},
	{contract: "StackOrderName", value: "inside-out"},
	{contract: "StackOrder", value: "value"},
	{contract: "MarkerName", value: "arrow"},
	{contract: "MarkerOptions", value: {markerEnd: "arrow"}},
]
nativeSampleChecks: {
	unique: true & list.UniqueItems([for sample in nativeSamples {sample.contract}])
	contracts: [for sample in nativeSamples {true & list.Contains(standaloneContracts, sample.contract)}]
}
_nativeSource: "// Generated by pnpm generate:api from api/marks/common. DO NOT EDIT.\npackage markadmission\n\n" + strings.Join([for name, definition in _nativeDependencyDefinitions {"#\(name): \(definition)\n"}, for name in standaloneContracts {"#\(name): \(nativeDefinitions[name])\n"}, for name, definition in _auxiliaryDefinitions {"#\(name): \(definition)\n"}], "\n")
nativeChecks: [{files: {"contracts.cue": _nativeSource, "examples.cue": "package markadmission\n" + strings.Join([for index, sample in nativeSamples {"example\(index): #\(sample.contract) & \(json.Marshal(sample.value))"}], "\n") + "\n" + strings.Join([for index, sample in auxiliarySamples {"auxiliary\(index): #" + strings.Join([if sample.definition != _|_ {sample.definition}, if sample.definition == _|_ {sample.name}], "") + " & " + json.Marshal(sample.value)}], "\n") + "\n"}}]
nativeFiles: {"packages/vgplot/spec/src/generated/common-marks.cue": _nativeSource}

#AuxiliarySample: {name: "Channels", source: "MarkOptions", property: "channels", value!: _} | {name: "TipFormat", source: "TipOptions", property: "format", value!: _} | {name: "ChannelInterval", definition: "TimeIntervalName", value!: _}
auxiliarySamples: [...#AuxiliarySample] & [{name: "Channels", value: {extra: "x"}}, {name: "TipFormat", value: {x: true, y: ".2f"}}, {name: "ChannelInterval", value: "day"}]
_auxiliaryDefinitions: {for sample in auxiliarySamples if sample.source != _|_ {(sample.name): _shape.projections[([for property in contractIndex[sample.source].properties if property.name == sample.property {property.type}])[0]].native}}
auxiliaryChecks: {names: true & list.UniqueItems([for sample in auxiliarySamples {sample.name}])}
