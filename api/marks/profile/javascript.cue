package profile

import (
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/model"
	"idl.uw.edu/mosaic/api/render"
)

javascriptProfiles: {ordinary: "mark", explicit: "explicitType", implicit: "implicitType"}
decoratorTypes: [...model.#Name] & ["frame", "axisX", "axisY", "axisFx", "axisFy", "gridX", "gridY", "gridFx", "gridFy", "hexgrid", "graticule", "sphere"]
connectedPrefixes: [string, ...string] & ["area", "line"]
javascriptProfileChecks: {
	decorators: true & list.UniqueItems(decoratorTypes)
	prefixes:   true & list.UniqueItems(connectedPrefixes)
}
javascriptFiles: "packages/vgplot/vgplot/src/generated/mark-profiles.js": "// Generated by pnpm generate:api from api/marks/profile. DO NOT EDIT.\nexport const MARK_DECORATORS = new Set([" + strings.Join([for name in decoratorTypes {(render.#TypeScriptLiteral & {value: name}).text}], ", ") + "]);\nexport const CONNECTED_PREFIXES = [" + strings.Join([for prefix in connectedPrefixes {(render.#TypeScriptLiteral & {value: prefix}).text}], ", ") + "];\n"
