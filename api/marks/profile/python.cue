package profile

import (
	"encoding/json"
	"list"
	"regexp"
	"strings"
	"idl.uw.edu/mosaic/api/model"
	python "idl.uw.edu/mosaic/api/languages/python"
)

pythonMarkProfile: {
	data: {name: "data", annotation: "MarkData", default: "None"}
	channels: {annotation: "ChannelValue | UNSET", default: "UNSET"}
	options: {name: "options", annotation: "Any"}
	returns: "Mark"
	runtime: "mark_from_arguments"
}

#PythonMarkDescription: {
	description!: string
	key!:         model.#Name
	_plain:       regexp.ReplaceAll("\\[([^\\]]+)\\]\\([^)]*\\)", description, "${1}")
	_references:  regexp.ReplaceAll("\\[([^\\]]+)\\]\\[[^\\]]*\\]", _plain, "${1}")
	_footnotes:   regexp.ReplaceAll("\\[([0-9]+)\\]", _references, "")
	_shortcuts:   regexp.ReplaceAll("\\[([^\\]]+)\\]", _footnotes, "${1}")
	_collapsed:   strings.TrimSpace(regexp.ReplaceAll("\\s+", _shortcuts, " "))
	_first:       regexp.Find("^.*?\\.(?:\\s|$)|^.*$", _collapsed)
	text:         string
	if _first != "" {text: strings.TrimSpace(_first)}
	if _first == "" {text: "The \(key) mark."}
}
#PythonMarks: {
	marks!: [...model.#PythonMark]
	publicModule?: "vgplot._generated.marks"
	let Profile = pythonMarkProfile
	checks: {
		keys: true & list.UniqueItems([for mark in marks {mark.key}])
		names: true & list.UniqueItems([for mark in marks {mark.name}])
		for mark in marks {
			"\(mark.key)": {
				name: true & (mark.name == (python.#Identifier & {wire: mark.key}).name)
				channels: true & list.UniqueItems(mark.channels)
				reserved: [for name in mark.channels {true & !list.Contains(["mark", "data"], name)}]
				identifiers: [for name in mark.channels {true & regexp.Match("^[A-Za-z][A-Za-z0-9]*$", name)}]
			}
		}
	}
	text: """
 # Generated by pnpm generate:api from api/marks/common. DO NOT EDIT.
 from __future__ import annotations

 from typing import Any

 from .._types import UNSET, ChannelValue, MarkData
 from .._mark_runtime import \(Profile.runtime) as _mark
 from ..plot import Mark


 \(strings.Join([for mark in marks {"def " + mark.name + "(\n    " + Profile.data.name + ": " + Profile.data.annotation + " = " + Profile.data.default + ",\n    *,\n" + strings.Join([for channel in mark.channels {"    " + (python.#Identifier & {wire: channel}).name + ": " + Profile.channels.annotation + " = " + Profile.channels.default + ",\n"}], "") + "    **" + Profile.options.name + ": " + Profile.options.annotation + ",\n) -> " + Profile.returns + ":\n    " + json.Marshal((#PythonMarkDescription & {description: mark.description, key: mark.key}).text) + "\n    return _mark(" + json.Marshal(mark.key) + ", locals())"}], "\n\n\n"))


 __all__ = \(json.Marshal([for mark in marks {mark.name}]))
 \(strings.Join([if publicModule != _|_ {"\nfor _name in __all__:\n    globals()[_name].__module__ = " + json.Marshal(publicModule) + "\n"}], ""))
 """
}

#PythonAnnotation: "str" | "Any" | "MarkData" | "Mark" | "Directive" | "dict[str, str]"
#PythonParameter: {
	name!:       model.#Name
	annotation!: #PythonAnnotation
	kind!:       "positional-or-keyword" | "keyword-rest"
	default?:    "None"
	if default != _|_ {kind: "positional-or-keyword", annotation: "MarkData"}
}
#PythonFactory: {description!: string & !=""} & ({
	name:      "mark"
	module:    "vgplot.plot"
	operation: "mark"
	parameters: [
		{name: "name", kind: "positional-or-keyword", annotation: "str"},
		{name: "data", kind: "positional-or-keyword", annotation: "MarkData", default: "None"},
		{name: "enc", kind: "keyword-rest", annotation: "Any"},
	] & [...#PythonParameter]
	returns: "Mark"
} | {
	name:      "channels"
	module:    "vgplot.encodings"
	operation: "channels"
	parameters: [{name: "kwargs", kind: "keyword-rest", annotation: "str"}] & [...#PythonParameter]
	returns: "dict[str, str]"
} | {
	name:      "directive"
	module:    "vgplot.plot"
	operation: "directive"
	parameters: [
		{name: "key", kind: "positional-or-keyword", annotation: "str"},
		{name: "value", kind: "positional-or-keyword", annotation: "Any"},
	] & [...#PythonParameter]
	returns: "Directive"
})
#PythonFactoryProjection: {
	factory!: #PythonFactory
	let F = factory
	_arguments: [for parameter in F.parameters {parameter.name}]
	signature: "def " + F.name + "(" + strings.Join([for parameter in F.parameters {strings.Join([if parameter.kind == "keyword-rest" {"**"}], "") + parameter.name + ": " + parameter.annotation + strings.Join([if parameter.default != _|_ {" = " + parameter.default}], "")}], ", ") + ") -> " + F.returns
	text: signature + ":\n    " + json.Marshal(F.description) + "\n    return _runtime." + F.operation + "(" + strings.Join(_arguments, ", ") + ")\n\n\n" + F.name + ".__module__ = " + json.Marshal(F.module)
}
