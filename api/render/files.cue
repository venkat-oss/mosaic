package render

import (
	"encoding/json"
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/model"
)

#Facade: {
	symbols!: [...model.#Symbol]
	let S = list.Sort(symbols, {x: _, y: _, less: strings.ToLower(x.key) < strings.ToLower(y.key)})
	let Modules = {for symbol in S {"\(symbol.module)": true}}
	let Names = [for symbol in S {symbol.name}]
	let Imports = [for name in list.Sort([for module, _ in Modules {module}], list.Ascending) {
		"from .\(name) import (\n\(strings.Join([for symbol in S if symbol.module == name {"    \(symbol.name),"}], "\n"))\n)"
	}]
	text: """
		# Generated by pnpm generate:api from api/compose. DO NOT EDIT.
		from __future__ import annotations

		\(strings.Join(Imports, "\n\n"))


		__all__ = \(json.Marshal(Names))

		"""
}
