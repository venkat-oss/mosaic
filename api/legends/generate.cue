package legends

import (
	"encoding/json"
	"list"
	"strings"
)

_header: "Generated by pnpm generate:api from api/legends. DO NOT EDIT."
_shared: [for option in options if option.scope == "shared" {option}]
_positional: list.Sort([for option in options if option.pythonOrder >= 0 {option}], {
	x:    _, y: _
	less: x.pythonOrder < y.pythonOrder
})
checks: {
	channels: true & list.UniqueItems([for api in apis {api.channel}])
	jsNames: true & list.UniqueItems([for api in apis {api.js}])
	pythonNames: true & list.UniqueItems([for api in apis {api.python}])
	optionNames: true & list.UniqueItems([for option in options {option.name}])
	pythonOptions: true & list.UniqueItems([for option in options {option.python}])
	pythonOrder: true & ([for option in _positional {option.pythonOrder}] == list.Range(0, len(_positional), 1))
}
_tsFields: [for option in _shared {"  /** \(option.description) */\n  \(option.name)?: \(option.kind);"}]
_jsFunctions: [for api in apis {
	"""
	export function \(api.js)(options) {
	  return legend.call(this, '\(api.channel)', options);
	}
	"""
}]
_pythonFunctions: [for api in apis {
	"""
	def \(api.python)(
	\(strings.Join([for option in _positional {"    \(option.python): Any = None,"}], "\n"))
	    **kwargs: Any,
	) -> dict[str, Any]:
	    \"\"\"Create a legend for a plot's \(api.channel) scale.\"\"\"
	    return _legend(
	        "\(api.channel)", \(strings.Join([for option in _positional {"\(option.python)=\(option.python)"}], ", ")), **kwargs
	    )
	"""
}]

_optionsJS: strings.Join([for option in options {"| `\(option.name)` | `\(option.kind)` | \(option.description) |"}], "\n")
_optionsPython: strings.Join([for option in options {"| `\(option.python)` | `\(option.kind)` | \(option.description) |"}], "\n")
_methodDocs: {
	for lang in ["js", "python"] {
		"\(lang)": strings.Join([for api in apis {
			let Name = {js: api.js, python: api.python}[lang]
			let Signature = {js: "\(Name)(options)", python: "vg.\(Name)(\(strings.Join([for option in _positional {"\(option.python)=None"}], ", ")), **kwargs)"}[lang]
			"## \(Name)\n\n`\(Signature)`\n\nCreate a new legend for a plot's `\(api.channel)` scale.\n"
		}], "\n")
	}
}

_schemaProperties: {
	for option in options {
		"\(option.name)": {
			description: option.description
			if option.kind == "ParamRef" {"$ref": "#/definitions/ParamRef"}
			if option.kind != "ParamRef" {type: option.kind}
		}
	}
}
_schema: definitions: {
	for name, requiredFields in {
		PlotLegend: ["legend"]
		Legend: list.Sort(list.Concat([["legend"], [for option in options if option.scope == "standalone" {option.name}]]), list.Ascending)
	} {
		"\(name)": {
			additionalProperties: false
			description: {PlotLegend: docs.inlineDescription, Legend: docs.standaloneDescription}[name]
			type:     "object"
			required: requiredFields
			properties: {
				legend: {
					description: docs.channelDescription
					type:        "string"
					enum: [for api in apis {api.channel}]
				}
				for option in options if option.scope == "shared" || name == "Legend" {
					"\(option.name)": _schemaProperties[option.name]
				}
			}
		}
	}
}

schemaFragment: _schema

_artifacts: {
