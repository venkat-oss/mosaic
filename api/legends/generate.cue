		    return omit_none(
		        {
		            "legend": kind,
		\(strings.Join([for option in _positional {"            \(json.Marshal(option.name)): \(option.python),"}], "\n"))
		            **{_OPTION_NAMES.get(k, camelize(k)): v for k, v in kwargs.items()},
		        }
		    )


