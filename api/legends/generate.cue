files: _artifacts

nativeObjects: {
	for Name in ["PlotLegend", "Legend"] {
		(Name): [{
			preferred: false
			fields: [
				{name: "legend", required: true, native: "(" + strings.Join([for API in apis {json.Marshal(API.channel)}], " | ") + ")"},
				for Option in options if Option.scope == "shared" || Name == "Legend" {
					name:     Option.name
					required: Option.scope == "standalone"
					native: {if Option.kind == "ParamRef" {value: "#ParamRef"}, if Option.kind == "boolean" {value: "bool"}, if Option.kind != "ParamRef" && Option.kind != "boolean" {value: Option.kind}}.value
				},
			]
		}]
	}
}
nativeDefinitions: {for Name, Branches in nativeObjects {(Name): "{" + strings.Join([for Field in Branches[0].fields {json.Marshal(Field.name) + strings.Join([if Field.required {"!"}, if !Field.required {"?"}], "") + ": " + Field.native}], ", ") + "}"}}
