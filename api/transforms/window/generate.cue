package window

import (
	"encoding/json"
	"strings"
	"idl.uw.edu/mosaic/api/render"
)

let Contracts = contracts
let Bases = baseContracts
let External = externalReferences
let Shapes = argumentShapes
_shape: render.#ShapeProjection & {expressions: typeExpressions, contracts: Contracts, baseContracts: Bases, externalReferences: External, argumentShapes: Shapes}
shapeChecks: _shape.checks
nativeDefinitions: json.Unmarshal(json.Marshal({for name, projection in _shape.contractProjections {(name): projection.native}}))
nativeImports: _shape.nativeImports
schemaFragment: definitions: {for contract in contracts if contract.wire {(contract.name): _shape.contractProjections[contract.name].schema}}
parserRegistrations: [for api in apis {{key: api.key, order: api.parserOrder}}, for api in intervalAPIs {{key: api.key, order: api.parserOrder}}]
pythonSymbols: [for api in apis if api.targets.python {{key: api.key, name: api.python, module: "window"}}]
javascriptExports: [for api in apis {{source: api.origin, name: api.key}}, for api in intervalAPIs {{source: api.origin, name: api.key}}, {source: "@uwdata/mosaic-sql", name: "interval"}, for frame in frameKinds {{source: "@uwdata/mosaic-sql", name: frame.javascript}}]
sections: [for section in _sections {path: "packages/vgplot/spec/src/spec/Transform.ts", id: section.id, owner: "window", text: (render.#DeclarationSection & {declaration: _shape.contractProjections[section.name].declaration}).text}]
_header: "Generated by pnpm generate:api from api/transforms/window. DO NOT EDIT."
_metadataLines: [
	"export const WINDOW_TRANSFORM_APIS = {",
	for api in apis {"  \(api.key): { python: \(strings.Join([if api.targets.python {(render.#TypeScriptLiteral & {value: api.python}).text}, if !api.targets.python {"null"}], "")), parser: \((render.#TypeScriptLiteral & {value: api.parserAdapter}).text) },"},
	"};",
	"export const FRAME_KINDS = [",
	for frame in frameKinds {"  { key: \((render.#TypeScriptLiteral & {value: frame.key}).text), type: \((render.#TypeScriptLiteral & {value: frame.type}).text), javascript: \((render.#TypeScriptLiteral & {value: frame.javascript}).text) },"},
	"];",
]
_typeFiles: {
	"packages/vgplot/spec/src/generated/window.cue": "// \(_header)\npackage windowadmission\n\n" + strings.Join([for name in standaloneContracts {"#\(name): \(nativeDefinitions[name])\n"}], "\n")
	"packages/vgplot/spec/src/generated/window.js": "// \(_header)\n" + strings.Join(_metadataLines, "\n") + "\n"
	"packages/vgplot/spec/src/spec/Interval.ts": "// \(_header)\n" + strings.Join([for contract in contracts if contract.name == "IntervalTransform" || len([for api in intervalAPIs if api.name == contract.name {api}]) > 0 {_shape.contractProjections[contract.name].declaration}], "\n")
}
files: {
	for path, content in _typeFiles {(path): content}
	for path, content in templateFiles {(path): content}
	for path, content in pythonFiles {(path): content}
}

_sections: [{name: "ArgLagLead", id: "ArgLagLead-11"}, {name: "RowNumber", id: "RowNumber-42"}, {name: "Rank", id: "Rank-43"}, {name: "DenseRank", id: "DenseRank-44"}, {name: "PercentRank", id: "PercentRank-45"}, {name: "CumeDist", id: "CumeDist-46"}, {name: "NTile", id: "NTile-47"}, {name: "Lag", id: "Lag-48"}, {name: "Lead", id: "Lead-49"}, {name: "FirstValue", id: "FirstValue-50"}, {name: "LastValue", id: "LastValue-51"}, {name: "NthValue", id: "NthValue-52"}]
standaloneContracts: ["IntervalTransform", for api in intervalAPIs {api.name}]

nativeObjects: _shape.nativeObjects

admissionDefinitions: _shape.admissionDefinitions

sharedTypeImports: [{path: "packages/vgplot/spec/src/spec/Transform.ts", imports: [for Reference in externalReferences if Reference.source != "./Transform.js" {Reference}]}]
