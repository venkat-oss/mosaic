package aggregate

import (
	"encoding/json"
	"list"
	"strings"
)

_pythonFunctions: [for api in apis if api.targets.python {
	let Args = [for argument in api.arguments {argument.name + ": " + argument.type + strings.Join([if !argument.required {" | UNSET = UNSET"}], "")}]
	let Tuple = strings.Join([for argument in api.arguments {argument.name}], ", ") + strings.Join([if len(api.arguments) == 1 {","}], "")
	let Description = strings.Split(api.description, ".")[0] + "."
	let Return = strings.Join([if api.pythonEmpty == "none" {"{\(json.Marshal(api.key)): None, **options}"}, if api.pythonEmpty == "transform-empty-string" {"_transform(\(json.Marshal(api.key)), (\(Tuple)), options)"}], "")
	"def \(api.python)(\(strings.Join(list.Concat([Args, ["**options: Any"]]), ", "))) -> dict[str, Any]:\n    \(json.Marshal(Description))\n    return \(Return)"
}]
pythonFiles: {
	"packages/vgplot/vgplot-python/vgplot/_generated/aggregate.py": "# Generated by pnpm generate:api from api/transforms/aggregate. DO NOT EDIT.\nfrom __future__ import annotations\n\nfrom typing import Any\n\nfrom .._encoding_runtime import transform as _transform\nfrom .._types import UNSET, TransformArg\n\n\n" + strings.Join(_pythonFunctions, "\n\n\n") + "\n\n\n__all__ = \(json.Marshal([for api in apis if api.targets.python {api.python}]))\n"
}
