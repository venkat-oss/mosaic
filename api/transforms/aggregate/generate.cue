package aggregate

import (
	"encoding/json"
	"strings"
	"idl.uw.edu/mosaic/api/render"
)

let Contracts = contracts
let Bases = baseContracts
let External = externalReferences
let Shapes = argumentShapes
_shape: render.#ShapeProjection & {expressions: typeExpressions, contracts: Contracts, baseContracts: Bases, externalReferences: External, argumentShapes: Shapes}
shapeChecks: _shape.checks
nativeDefinitions: json.Unmarshal(json.Marshal({for name, projection in _shape.contractProjections {(name): projection.native}}))
nativeImports: _shape.nativeImports
schemaFragment: definitions: {for contract in contracts if contract.wire {(contract.name): _shape.contractProjections[contract.name].schema}}
parserRegistrations: [for api in apis {{key: api.key, order: api.parserOrder}}]
pythonSymbols: [for api in apis if api.targets.python {{key: api.key, name: api.python, module: "aggregate"}}]
javascriptExports: [for api in apis {{source: api.origin, name: api.key}}, for api in jsOnlyAPIs {{source: api.origin, name: api.key}}]
sections: [for section in _sections {path: "packages/vgplot/spec/src/spec/Transform.ts", id: section.id, owner: "aggregate", text: (render.#DeclarationSection & {declaration: _shape.contractProjections[section.name].declaration}).text}]
_header: "Generated by pnpm generate:api from api/transforms/aggregate. DO NOT EDIT."
_metadataLines: [
	"export const AGGREGATE_TRANSFORM_APIS = {",
	for api in apis {"  \(api.key): { python: \(strings.Join([if api.targets.python {(render.#TypeScriptLiteral & {value: api.python}).text}, if !api.targets.python {"null"}], "")), parser: \((render.#TypeScriptLiteral & {value: api.parserAdapter}).text) },"},
	"};",

]
_typeFiles: {
	"packages/vgplot/spec/src/generated/aggregate.cue": "// \(_header)\npackage aggregateadmission\n\n" + strings.Join([for name in standaloneContracts {"#\(name): \(nativeDefinitions[name])\n"}], "\n")
	"packages/vgplot/spec/src/generated/aggregate.js": "// \(_header)\n" + strings.Join(_metadataLines, "\n") + "\n"
}
files: {
	for path, content in _typeFiles {(path): content}
	for path, content in templateFiles {(path): content}
	for path, content in pythonFiles {(path): content}
}

_sections: [{name: "AggregateOptions", id: "AggregateOptions-7"}, {name: "Argmax", id: "Argmax-22"}, {name: "Argmin", id: "Argmin-23"}, {name: "Avg", id: "Avg-24"}, {name: "Count", id: "Count-25"}, {name: "Covariance", id: "Covariance-26"}, {name: "CovarPop", id: "CovarPop-27"}, {name: "First", id: "First-28"}, {name: "Geomean", id: "Geomean-29"}, {name: "Last", id: "Last-30"}, {name: "Max", id: "Max-31"}, {name: "Min", id: "Min-32"}, {name: "Median", id: "Median-33"}, {name: "Mode", id: "Mode-34"}, {name: "Product", id: "Product-35"}, {name: "Quantile", id: "Quantile-36"}, {name: "Stddev", id: "Stddev-37"}, {name: "StddevPop", id: "StddevPop-38"}, {name: "Sum", id: "Sum-39"}, {name: "Variance", id: "Variance-40"}, {name: "VarPop", id: "VarPop-41"}]
