package column

import (
	"encoding/json"
	"list"
	"strings"
	paramFamily "idl.uw.edu/mosaic/api/params"
	"idl.uw.edu/mosaic/api/render"
)

let Contracts = contracts
let External = externalReferences
let Shapes = argumentShapes
_shape: render.#ShapeProjection & {expressions: typeExpressions, contracts: Contracts, externalReferences: External, argumentShapes: Shapes}
shapeChecks: _shape.checks
nativeDefinitions: json.Unmarshal(json.Marshal({for name, projection in _shape.contractProjections {(name): projection.native}}))
nativeImports: _shape.nativeImports
schemaFragment: definitions: {for contract in contracts if contract.wire {(contract.name): _shape.contractProjections[contract.name].schema}}
sharedArguments: argumentShapes
sharedFrameContracts: [for contract in contracts if contract.name == "FrameExclude" || contract.name == "FrameValue" || contract.name == "WindowOptions" {contract}]
javascriptExports: [{source: expressionAPIs[0].origin, name: expressionAPIs[0].key}, for api in apis {{source: api.origin, name: api.key}}]

_sections: [
	{name: "TransformField", id: "TransformField-3"},
	{name: "FrameExclude", id: "FrameExclude-4"},
	{name: "FrameValue", id: "FrameValue-5"},
	{name: "WindowOptions", id: "WindowOptions-6"},
	{name: "Nullary", id: "Nullary-8"},
	{name: "Unary", id: "Unary-9"},
	{name: "Binary", id: "Binary-10"},
	{name: "BinInterval", id: "BinInterval-12"},
	{name: "Bin", id: "Bin-13"},
	{name: "Column", id: "Column-14"},
	{name: "DateMonth", id: "DateMonth-15"},
	{name: "DateMonthDay", id: "DateMonthDay-16"},
	{name: "DateDay", id: "DateDay-17"},
	{name: "Centroid", id: "Centroid-18"},
	{name: "CentroidX", id: "CentroidX-19"},
	{name: "CentroidY", id: "CentroidY-20"},
	{name: "GeoJSON", id: "GeoJSON-21"},
]
_argumentDeclarations: {for argumentShape in argumentShapes {(argumentShape.name): (render.#ArgumentDeclaration & {shape: argumentShape}).declaration}}
sections: [for section in _sections {
	path:  "packages/vgplot/spec/src/spec/Transform.ts"
	id:    section.id
	owner: "column"
	text:  string
	if _argumentDeclarations[section.name] != _|_ {text: (render.#DeclarationSection & {declaration: _argumentDeclarations[section.name]}).text}
	if _argumentDeclarations[section.name] == _|_ {text: (render.#DeclarationSection & {declaration: _shape.contractProjections[section.name].declaration}).text}
}]
_header: "Generated by pnpm generate:api from api/transforms/column. DO NOT EDIT."
_metadataLines: [
	"export const SQL_KEY = \((render.#TypeScriptLiteral & {value: expressionAPIs[0].key}).text);",
	"export const COLUMN_TRANSFORM_APIS = {",
	for api in apis {"  \(api.key): { python: \((render.#TypeScriptLiteral & {value: api.python}).text), parser: \((render.#TypeScriptLiteral & {value: api.parserAdapter}).text) },"},
	"};",
]
_typeFiles: {
	"packages/vgplot/spec/src/spec/Expression.ts": "// \(_header)\n" + strings.Join([for contract in contracts if contract.name == "Expression" || contract.name == "SQLExpression" || contract.name == "AggregateExpression" {_shape.contractProjections[contract.name].declaration}], "\n")
	"packages/vgplot/spec/src/generated/column.cue": "// \(_header)\npackage columnadmission\n\n#ParamRef: \(paramFamily.nativeDefinitions.ParamRef)\n\n" + strings.Join([for name in standaloneContracts {"#\(name): \(nativeDefinitions[name])\n"}], "\n")
	"packages/vgplot/spec/src/generated/column.js": "// \(_header)\n" + strings.Join(_metadataLines, "\n") + "\n"
}
files: {
	for path, content in _typeFiles {(path): content}
	for path, content in templateFiles {(path): content}
	for path, content in pythonFiles {(path): content}
}

sharedFrameExpressions: (render.#ExpressionClosure & {
	expressions: typeExpressions
	roots: list.Concat([["fieldRef", "numberValue", "nullValue", "unaryField"], list.Concat([for contract in sharedFrameContracts {
		if contract.kind == "alias" {[contract.expression]}
		if contract.kind == "interface" {[for property in contract.properties {property.type}]}
	}])])
}).selected

nativeObjects: _shape.nativeObjects

admissionDefinitions: _shape.admissionDefinitions

sharedTypeImports: [{path: "packages/vgplot/spec/src/spec/Transform.ts", imports: [for Reference in externalReferences if Reference.source != "./Transform.js" {Reference}, {name: "SQLExpression", source: "./Expression.js"}]}]
