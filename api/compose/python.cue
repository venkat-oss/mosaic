package compose

import (
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/model"
	"idl.uw.edu/mosaic/api/render"
)

#Python: {
	owned!: model.#Symbols
	let O = owned
	groups: {
		for group in ["marks", "attributes", "encodings"] {
			"\(group)": list.Sort(O[group], {x: _, y: _, less: strings.ToLower(x.key) < strings.ToLower(y.key)})
		}
		legends: O.legends
	}
	checks: {
		for group, symbols in groups {
			"\(group)": {
				keys: true & list.UniqueItems([for symbol in symbols {symbol.key}])
				names: true & list.UniqueItems([for symbol in symbols {symbol.name}])
			}
		}
	}
	let G = groups
	let All = list.Concat([for group in ["marks", "attributes", "encodings", "legends"] {[for symbol in G[group] {symbol.name}]}])
	checks: allNames: true & list.UniqueItems(All)
	files: {
		for group in ["marks", "attributes", "encodings"] {
			let Group = group
			"packages/vgplot/vgplot-python/vgplot/_generated/\(Group).py": (render.#Facade & {symbols: G[Group]}).text
		}
		"packages/vgplot/spec/src/generated/transform-keys.js": """
			// Generated by pnpm generate:api from api/compose. DO NOT EDIT.
			export const TRANSFORM_KEYS = new Set([
			\(strings.Join([for symbol in G.encodings {"  '\(symbol.key)',"}], "\n"))
			]);

			"""
	}
}
