package compose

import (
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/model"
	"idl.uw.edu/mosaic/api/render"
)

#TransformRegistration: {
	key!:   model.#Name
	order!: int & >=0
}

#TransformRegistry: {
	owned!: [...#TransformRegistration]
	let Records = owned
	checks: {
		keys: true & list.UniqueItems([for item in Records {item.key}])
		order: true & list.UniqueItems([for item in Records {item.order}])
	}
	ordered: list.Sort(Records, {x: _, y: _, less: x.order < y.order})
	files: {
		"packages/vgplot/spec/src/config/transforms.js": """
  // Generated by pnpm generate:api from api/compose. DO NOT EDIT.
  export function transformNames(overrides = []) {
    return new Set([
  \(strings.Join([for item in ordered {"    \((render.#TypeScriptLiteral & {value: item.key}).text),"}], "\n"))
      ...overrides
    ]);
  }

  """
	}
}
