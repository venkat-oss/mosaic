package compose

import (
	"encoding/json"
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/model"
	"idl.uw.edu/mosaic/api/render"
	specmodel "idl.uw.edu/mosaic/api/spec/model:specmodel"
)

#PublicPython: {name!: model.#Name, module!: "data" | "encodings" | "params" | "plot" | "spec"}
#PublicContribution: {
	constantExports: *[] | [...{source!: string & !="", names!: [...{name!: model.#Name, alias?: model.#Name}]}]
	javascript: *[] | [...{group!: "core" | "column" | "aggregate" | "window" | "inputs" | "concat" | "space" | "data", name!: model.#Name, source!: string & !=""}]
	python: *[] | [...#PublicPython]
	inputNames: *[] | [...model.#Name]
	pythonViewKeys: *[] | [...model.#Name]
}
#PublicComposition: {
	contributions!: [...#PublicContribution]
	interactors!: [...#PythonInteractorSymbol]
	let Contributions = contributions
	let Interactors = interactors
	python: [...#PublicPython] & list.Concat([
		specmodel.pythonRootExports,
		list.Concat([for contribution in Contributions {contribution.python}]),
		[for item in Interactors {{name: item.name, module: "plot"}}],
	])
	pythonNames: list.SortStrings([for item in python {item.name}])
	let Python = python
	inputs: list.Concat([for contribution in Contributions {contribution.inputNames}])
	viewKeys: list.Concat([[for item in specmodel.componentParsers if item.pythonView {item.key}], list.Concat([for contribution in Contributions {contribution.pythonViewKeys}])])
	javascript: #JavaScriptExports & {contributions: Contributions}
	let PythonNames = pythonNames
	let ViewKeys = viewKeys
	checks: {
		pythonNames: true & list.UniqueItems(PythonNames)
		inputNames:  true & list.UniqueItems(inputs)
		viewKeys:    true & list.UniqueItems(ViewKeys)
	}
	files: {
		for path, content in javascript.files {(path): content}
		"packages/vgplot/spec/src/config/components.js": """
   // Generated by pnpm generate:api from api/compose. DO NOT EDIT.
   \(strings.Join([for index, item in specmodel.componentParsers if !list.Contains([for previous in list.Take(specmodel.componentParsers, index) {previous.source}], item.source) {
			"import { " + strings.Join([for parser in specmodel.componentParsers if parser.source == item.source {parser.parser}], ", ") + " } from '" + item.source + "';"
		}], "\n"))
   import { \(strings.Join([for item in specmodel.componentParsers {item.constant}], ", ")) } from '../constants.js';
   import { LAYOUT_COMPONENTS } from '../generated/layout-components.js';

   export function componentMap(overrides = []) {
     return new Map([
   \(strings.Join([for item in specmodel.componentParsers {"    [" + item.constant + ", " + item.parser + "],"}], "\n"))
       ...LAYOUT_COMPONENTS,
       ...overrides
     ]);
   }

   """
		"packages/vgplot/spec/src/config/inputs.js":               """
   // Generated by pnpm generate:api from api/compose. DO NOT EDIT.
   export function inputNames(overrides = []) {
     return new Set([
   \(strings.Join([for name in inputs {"    " + (render.#TypeScriptLiteral & {value: name}).text + ","}], "\n"))
       ...overrides
     ]);
   }

   """
		"packages/vgplot/vgplot-python/vgplot/__init__.py":        """
   # Generated by pnpm generate:api from api/compose. DO NOT EDIT.
   from __future__ import annotations

   from ._generated import *  # noqa: F403
   from ._generated import __all__ as _generated_all
   \(strings.Join([for source in ["data", "encodings", "params", "plot", "spec"] {"from ." + source + " import " + strings.Join(list.SortStrings([for item in Python if item.module == source {item.name}]), ", ")}], "\n"))

   __all__ = \(json.Marshal(pythonNames)) + list(_generated_all)  # pyright: ignore[reportUnsupportedDunderAll]

   """
		"packages/vgplot/vgplot-python/vgplot/_spec_contracts.py": """
   # Generated by pnpm generate:api from api/spec/model. DO NOT EDIT.
   from __future__ import annotations

   from typing import Any

   VIEW_KEYS = frozenset(\(json.Marshal(viewKeys)))
   RUNTIME_APIS: list[dict[str, Any]] = [
   \(strings.Join([for api in specmodel.pythonRuntimeAPIs {"    {\"name\": " + json.Marshal(api.name) + ", \"module\": " + json.Marshal(api.module) + ", \"parameters\": " + json.Marshal(api.parameters) + ", \"returns\": " + json.Marshal(api.returns) + "},"}], "\n"))
   ]

   """
		"packages/vgplot/spec/src/constants.js": "// Generated by pnpm generate:api from api/spec/model. DO NOT EDIT.\n" + strings.Join([for item in specmodel.astKinds {"export const " + item.constant + " = " + (render.#TypeScriptLiteral & {value: item.key}).text + ";"}], "\n") + "\n\n" + strings.Join([for contribution in Contributions for entry in contribution.constantExports {"export { " + strings.Join([for name in entry.names {name.name + strings.Join([if name.alias != _|_ {" as " + name.alias}], "")}], ", ") + " } from '" + entry.source + "';"}], "\n") + "\n"
	}
}
