package compose

import (
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/render"
	"idl.uw.edu/mosaic/api/model"
)

#InteractorRegistration: {
	key!:   model.#Name
	owner!: string & !=""
}
#InteractorAlias: {wire!: model.#Name, name!: model.#Name}
#PythonInteractorSymbol: {name!: model.#Name, module!: model.#Name}
#InteractorRegistry: {
	owned!: [...#InteractorRegistration]
	ownedAliases!: [...#InteractorAlias]
	python!: [...#PythonInteractorSymbol]
	ownedRuntimeClasses!: [...("Highlight" | "Nearest" | "Toggle" | "Interval1D" | "Interval2D" | "Region" | "PanZoom")]
	let Records = owned
	let Aliases = ownedAliases
	let Python = python
	aliasMap: {for alias in Aliases {(alias.wire): alias.name}}
	let AliasMap = aliasMap
	ordered: list.SortStrings([for record in Records {record.key}])
	checks: {
		uniqueNames: true & list.UniqueItems([for record in Records {record.key}])
		uniquePythonNames: true & list.UniqueItems([for item in Python {item.name}])
	}
	runtimeClasses: list.SortStrings([for key, _ in {for name in ownedRuntimeClasses {(name): true}} {key}])
	importSection: "import {\n" + strings.Join([for name in runtimeClasses {"  " + name}], ",\n") + "\n} from '@uwdata/mosaic-plot';\nimport { interactor } from './interactor-runtime.js';\n\n"
	files: {
		"packages/vgplot/spec/src/generated/interactors.js": "// Generated by pnpm generate:api from api/compose/interactors. DO NOT EDIT.\nexport const INTERACTOR_NAMES = [\n" + strings.Join([for Name in ordered {"  " + (render.#TypeScriptLiteral & {value: Name}).text + ","}], "\n") + "\n];\nexport const INTERACTOR_KEY_MAP = {\n" + strings.Join([for key in list.SortStrings([for Name, _ in AliasMap {Name}]) { let Value = AliasMap[key]
			"  " + key + ": " + (render.#TypeScriptLiteral & {value: Value}).text + ","
		}], "\n") + "\n};\n"
		"packages/vgplot/vgplot-python/vgplot/_generated/interactors.py": (render.#Facade & {symbols: [for item in Python {{key: item.name, name: item.name, module: item.module}}]}).text
	}
}
