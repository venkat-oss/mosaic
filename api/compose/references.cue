package compose

import (
	"list"
	"strings"
	"idl.uw.edu/mosaic/api/model"
)

#ReferenceSection: {
	id!:      model.#Name
	order!:   int & >=0
	content!: string & !=""
}

#TransformReference: {
	sections!: [...#ReferenceSection]
	let Sections = sections
	checks: {
		ids: true & list.UniqueItems([for section in Sections {section.id}])
		order: true & list.UniqueItems([for section in Sections {section.order}])
	}
	ordered: list.Sort(Sections, {x: _, y: _, less: x.order < y.order})
	files: {
		if len(Sections) > 0 {
			"docs/api/spec/transforms.md": """
				---
				title: Transform Contracts
				---
				<!-- Generated by pnpm generate:api from api/transforms. DO NOT EDIT. -->
				<script setup>
				  import { withBase } from 'vitepress';
				</script>

				# Transform Contracts

				Transforms derive column values used by marks and queries. These contracts
				describe the declarative format and its JavaScript/Python authoring adapters.
				The SQL expression and query engines retain their runtime implementations.

				\(strings.Join([for section in ordered {section.content}], "\n\n"))

				"""
		}
	}
}
