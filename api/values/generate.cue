package values

import (
	"strings"
	"idl.uw.edu/mosaic/api/render"
)

_valueProjections: {
	for valueContract in contracts {
		(valueContract.name): render.#ValueProjection & {contract: valueContract, index: contractIndex}
	}
}

nativeDefinitions: {for name, projection in _valueProjections {(name): projection.native}}
schemaFragment: definitions: {
	for contract in publicContracts {(contract.name): _valueProjections[contract.name].schema}
}

sections: []

_generatedHeader: "Generated by pnpm generate:api from api/values. DO NOT EDIT."
_typeFiles: {
	for file in ["CSSStyles.ts", "PlotTypes.ts"] {
		"packages/vgplot/spec/src/spec/\(file)": "// \(_generatedHeader)\n" + strings.Join([for contract in contracts if contract.file == file {_valueProjections[contract.name].declaration}], "\n")
	}
	"packages/vgplot/spec/src/generated/values.cue": "// \(_generatedHeader)\npackage valueadmission\n\n" + strings.Join([for contract in contracts {"#\(contract.name): \(nativeDefinitions[contract.name])\n"}], "\n")
	"packages/vgplot/plot/src/generated/symbol-types.js": "// \(_generatedHeader)\nexport const SYMBOL_TYPES = [\n\(strings.Join([for symbol in contractIndex.SymbolType.values {"  \((render.#TypeScriptLiteral & {value: symbol}).text),"}], "\n"))\n];\n"
}

files: {
	for path, content in _typeFiles {(path): content}
	for path, content in docFiles {(path): content}
	for path, content in templateFiles {(path): content}
	for path, content in pythonFiles {(path): content}
}
