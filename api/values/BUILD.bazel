load("@rules_cue//cue:cue.bzl", "cue_instance")
load("//build:cue.bzl", "cue_projection")

cue_instance(
    name = "package",
    srcs = glob(["*.cue"]),
    ancestor = "//cue.mod:module",
    package_name = "values",
    deps = [
        "//api/model:package",
        "//api/render:package",
    ],
    visibility = ["//visibility:public"],
)

cue_instance(
    name = "model",
    srcs = ["model.cue"],
    ancestor = "//cue.mod:module",
    package_name = "values",
    deps = ["//api/model:package"],
    visibility = ["//visibility:public"],
)

cue_projection(
    name = "contribution",
    instance = ":package",
    expression = "contribution",
    visibility = ["//visibility:public"],
)
