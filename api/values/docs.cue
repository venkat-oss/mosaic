package values

import (
	"encoding/json"
	"list"
	"strings"
)

valueDocs: {
	title: "Value Contracts"
	intro: """
		These shared types describe values used by plot attributes and mark channels.
		The TypeScript types are exported by `@uwdata/mosaic-spec`. JavaScript uses
		native values and the existing vgplot runtime; Python authoring uses its own
		host adapters. JSON/YAML specifications contain serializable values.
		"""
	admission: """
		The owning value definition and the complete specification can admit different
		values. Existing attribute unions also include parameter-reference strings;
		the generated contracts preserve their current admission behavior. For example,
		the ColorScheme definition accepts canonical scheme names and objects, while
		the complete plot attribute union also admits lowercase and uppercase strings.
		Use the documented canonical values in portable specifications.
		"""
	fixed: """
		`Fixed` is the string `"Fixed"` in a declarative specification. JavaScript
		uses the existing `vg.Fixed` Symbol. The parser supplies that Symbol to the
		runtime; generating declarations does not create a replacement identity.
		"""
	interval: """
		The dotX starters use a named parameter because the current mark runtime
		interprets a bare interval string as a column name. Passing the interval
		through a parameter keeps it constant: JSON/YAML use `$interval`, JavaScript
		uses `Param.value(...)`, and Python uses `param(...)`.
		"""
	python: """
		These aliases live in `vgplot._types` for binding annotations. They describe
		Python host values rather than adding callable public constructors. Python
		runtime serialization, caller discovery, and object identities are retained.
		An omitted mark channel uses the existing `UNSET` singleton; explicit `None`
		remains distinct. Callback functions are outside these Python value aliases.
		"""
}

_valueReferenceSections: [for contract in publicContracts {
	"""
		## \(contract.name)

		\(contract.description)
		""" + strings.Join([
		if contract.kind == "enum" {
			"\nValues: " + strings.Join([for val in contract.values {"`\(json.Marshal(val))`"}], ", ") + ".\n"
		},
		if contract.kind == "conditional" {
			"\nTypeScript selects the date or numeric interval branch from its generic argument. The existing wire-schema projection selects the default's first branch; it accepts time-interval strings and rejects numeric values at the Interval definition. The [numeric interval starter](/templates/values/numeric-interval.js) demonstrates `Interval<number>` in JavaScript. It is a native JavaScript example; the wire definition has no matching numeric variant.\n"
		},
		if list.Contains(["LiteralTimeInterval", "TimeIntervalName", "Interval"], contract.name) {"\n\(valueDocs.interval)\n"},
		if contract.kind == "host" {
			"\nTypeScript adapts `\(contract.host)` with these omitted members: " + strings.Join([for val in cssOmittedProperties {"`\(val)`"}], ", ") + ". The wire contract has \(len(cssKnownProperties)) named string properties for editor completion, numeric `length`, and permits additional string-valued keys.\n"
		},
		if contract.kind == "union" if len([for member in contract.members if member.kind == "template" if member.schemaAdapter == "open-string" {member}]) > 0 {
			"\nThe TypeScript numeric time template is projected as an unrestricted string in the existing wire schema. This preserves admission; it does not imply that arbitrary interval strings have runtime implementations.\n"
		},
		if contract.kind == "union" for member in contract.members if member.kind == "casefold" {
			"\nTypeScript also permits lowercase spellings, with completion hints retained. The existing wire definition's lowercase branches are open objects rather than lowercase strings. Canonical names: " + strings.Join([for val in contractIndex[member.reference].values {"`\(val)`"}], ", ") + ".\n"
		},
		for item in valueExamples if item.contract == contract.name {
			"\nStarter: [YAML](/templates/values/\(item.name).yaml), [JSON](/templates/values/\(item.name).json), [JavaScript](/templates/values/\(item.name).js), <a :href=\"withBase('/templates/values/\(item.name).py')\" download>Python</a>.\n"
		},
	], "")
}]

docFiles: {
	"docs/api/spec/values.md": """
		---
		title: \(valueDocs.title)
		---
		<!-- Generated by pnpm generate:api from api/values. DO NOT EDIT. -->
		<script setup>
		  import { withBase } from 'vitepress';
		</script>

		# \(valueDocs.title)

		\(valueDocs.intro)

		\(valueDocs.admission)

		\(valueDocs.fixed)

		## Host applicability

		| Native host value | Adapter |
		| --- | --- |
		\(strings.Join([for adapter in hostAdapters {"| `\(adapter.reference)` | \(adapter.description) |"}], "\n"))

		\(strings.Join(_valueReferenceSections, "\n"))

		## Python host values

		\(valueDocs.python)

		\(strings.Join([for alias in pythonAliases {
		let Expression = (#RenderPythonType & {type: alias.type}).text
		let Statement = alias.name + " = " + Expression
		let Display = {
			if len(Statement) <= 88 {text: Statement}
			if len(Statement) > 88 if len(Expression) <= 84 {text: alias.name + " = (\n    " + Expression + "\n)"}
			if len(Statement) > 88 if len(Expression) > 84 {
				text: alias.name + " = (\n" + strings.Join([for i, member in alias.type.members {"    " + strings.Join([if i > 0 {"| "}], "") + (#RenderPythonType & {type: member}).text}], "\n") + "\n)"
			}
		}
		"### \(alias.name)\n\n\(alias.description)\n\n```python\n\(Display.text)\n```\n"
	}], "\n"))

		| Host adapter | Behavior |
		| --- | --- |
		\(strings.Join([for adapter in pythonAdapters {"| `\(adapter.reference)` | \(adapter.description) |"}], "\n"))

		The <a :href="withBase('/templates/values/python-adapters.py')" download>Python host-adapter starter</a>
		uses native dates, a dataframe, source references, and the omission sentinel.
		It is Python-only; native frame and sentinel objects have no JSON/YAML value representation.
		This optional example requires PyArrow (`uv add pyarrow`) alongside vgplot.

		"""
}
