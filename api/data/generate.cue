package data

import (
	"encoding/json"
	"strings"
	paramFamily "idl.uw.edu/mosaic/api/params"
	"idl.uw.edu/mosaic/api/render"
)

let Contracts = contracts
_shape: render.#ShapeProjection & {
	expressions: typeExpressions
	contracts:   Contracts
	externalReferences: [{name: "ParamRef", owner: "params", source: "./Param.js"}]
}
shapeChecks: _shape.checks
nativeDefinitions: json.Unmarshal(json.Marshal({for name, projection in _shape.contractProjections {(name): projection.native}}))
schemaFragment: definitions: {for contract in contracts if contract.wire {(contract.name): _shape.contractProjections[contract.name].schema}}
sections: []
_header:        "Generated by pnpm generate:api from api/data. DO NOT EDIT."
_nativePrelude: "#ParamRef: \(paramFamily.nativeDefinitions.ParamRef)\n"
_typeFiles: {
	"packages/vgplot/vgplot/src/plot/data.js": "// \(_header)\nexport function \(jsSourceFactory.name)(\(strings.Join([for parameter in jsSourceFactory.parameters {parameter.name + strings.Join([if !parameter.required {" = " + parameter.default}], "")}], ", "))) {\n  return { table, options };\n}\n"

	"packages/vgplot/spec/src/spec/Data.ts": "// \(_header)\n" + strings.Join([for contract in dataContracts {_shape.contractProjections[contract.name].declaration}], "\n")
	"packages/vgplot/spec/src/spec/PlotFrom.ts": "// \(_header)\nimport { ParamRef } from './Param.js';\n\n" + strings.Join([for contract in sourceContracts {_shape.contractProjections[contract.name].declaration}], "\n")
	"packages/vgplot/spec/src/generated/data.cue": "// \(_header)\npackage dataadmission\n\n" + _nativePrelude + strings.Join([for contract in contracts {"#\(contract.name): \(nativeDefinitions[contract.name])\n"}], "\n")
	"packages/vgplot/spec/src/generated/data.js": "// \(_header)\n" + strings.Join([
		for item in dataFormats {"export const \(item.constant) = \((render.#TypeScriptLiteral & {value: item.type}).text);"},
		"export const DATA_FORMATS = [" + strings.Join([for item in dataFormats {"{type: \((render.#TypeScriptLiteral & {value: item.type}).text), parser: \((render.#TypeScriptLiteral & {value: item.parser}).text)}"}], ", ") + "];",
		"export const DATA_LOADERS = " + (#JavaScriptStringMap & {values: {for item in dataFormats if item.authoring != "table" {(item.type): item.loader}}}).text + ";",
		"export const DATA_EXTENSIONS = " + (#JavaScriptStringMap & {values: {for item in dataFormats if item.extension != _|_ {(item.type): item.extension}}}).text + ";",
		"export const DATA_APIS = {" + strings.Join([for item in dataFormats {"\((render.#TypeScriptLiteral & {value: item.type}).text): " + (#JavaScriptStringMap & {values: {python: item.python.name, kind: item.authoring}}).text}], ", ") + "};",
		"export const DATA_INFERRED_APIS = " + (#JavaScriptStringMap & {values: {for item in dataFormats if item.pythonFileInference {(item.suffix): item.type}}}).text + ";",
		"export const DEFAULT_DATA_FORMAT = \((render.#TypeScriptLiteral & {value: defaultDataFormat}).text);",
		for item in runtimeNames {"export const \(item.name) = \((render.#TypeScriptLiteral & {value: item.value}).text);"},
	], "\n") + "\n"
}
files: {
	for path, content in _typeFiles {(path): content}
	for path, content in pythonFiles {(path): content}
	for path, content in docFiles {(path): content}
	for path, content in templateFiles {(path): content}
}

#JavaScriptStringMap: {
	values!: [string]: string
	text: "{" + strings.Join([for key, Value in values {"\((render.#TypeScriptLiteral & {value: key}).text): \((render.#TypeScriptLiteral & {value: Value}).text)"}], ", ") + "}"
}

nativeObjects: _shape.nativeObjects

admissionDefinitions: _shape.admissionDefinitions
