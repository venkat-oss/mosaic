load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load(":cue.bzl", "cue_binary")

exports_files(["duckdb.bzl", "cue.bzl", "javascript.bzl", "examples.bzl"] + glob(["backends-*.patch"]))

alias(
    name = "duckdb_sdk",
    actual = "@mosaic_duckdb_sdk//:duckdb",
    visibility = ["//visibility:public"],
)

alias(
    name = "duckdb_sdk_files",
    actual = "@mosaic_duckdb_sdk//:files",
    visibility = ["//visibility:public"],
)

js_library(
    name = "example_builder_source",
    srcs = ["example-builder.mjs"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "lint_fix_source",
    srcs = ["lint-fix.mjs"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "npm_install_sources",
    srcs = ["npm-install.mjs"],
)

js_library(
    name = "npm_render_entry",
    srcs = ["npm-render-consumer.mjs"],
    deps = [":npm_install_sources"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "example_builder",
    entry_point = "example-builder.mjs",
    data = ["//:node_modules/vite"],
    patch_node_fs = False,
    visibility = ["//visibility:public"],
)

js_library(
    name = "api_sources",
    srcs = ["api-sync.mjs"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "npm_pack",
    entry_point = "npm-pack.mjs",
    fixed_args = ["$(rlocationpath @pnpm//:pnpm)"],
    data = ["@pnpm//:pnpm"],
    patch_node_fs = False,
    visibility = ["//visibility:public"],
)

js_library(
    name = "vitest_environment",
    srcs = ["vitest-env.js"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "npm_core_consumer",
    entry_point = "npm-core-consumer.mjs",
    args = [
        "$(rlocationpath //packages/mosaic/sql:tarball)",
        "$(rlocationpath //packages/server/duckdb:tarball)",
        "$(rlocationpath //packages/mosaic/core:tarball)",
        "$(rlocationpath @pnpm//:pnpm)",
        "$(rlocationpath //:tsc)",
    ],
    data = [
        ":npm_install_sources",
        "//packages/mosaic/sql:tarball",
        "//packages/mosaic/sql:node_modules/@polyglot-sql/sdk",
        "//packages/server/duckdb:tarball",
        "//packages/mosaic/core:tarball",
        "//packages/server/duckdb:node_modules/@duckdb/node-api",
        "//packages/mosaic/core:node_modules/@duckdb/duckdb-wasm",
        "//packages/mosaic/core:node_modules/@types/emscripten",
        "//packages/mosaic/core:node_modules/@uwdata/flechette",
        "@pnpm//:pnpm",
        "//:tsc",
    ],
    patch_node_fs = False,
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "npm_consumer",
    entry_point = "npm-consumer.mjs",
    args = [
        "$(rlocationpath //packages/mosaic/sql:tarball)",
        "$(rlocationpath //packages/server/duckdb:tarball)",
        "packages/server/duckdb/node_modules/@duckdb/node-api",
        "packages/server/duckdb/node_modules/@uwdata/flechette",
        "$(rlocationpath @pnpm//:pnpm)",
        "$(rlocationpath //:tsc)",
    ],
    data = [
        ":npm_install_sources",
        "//packages/mosaic/sql:tarball",
        "//packages/mosaic/sql:node_modules/@polyglot-sql/sdk",
        "//packages/server/duckdb:tarball",
        "//packages/server/duckdb:node_modules/@duckdb/node-api",
        "//packages/server/duckdb:node_modules/@uwdata/flechette",
        "@pnpm//:pnpm",
        "//:tsc",
    ],
    patch_node_fs = False,
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)

cue_binary(
    name = "cue",
    visibility = ["//visibility:public"],
)

js_test(
    name = "cue_format",
    entry_point = "cue-format.mjs",
    args = ["$(rlocationpath :cue)"],
    data = [":cue", "//api:sources", "//api/catalog:sources"],
    copy_data_to_bin = False,
    visibility = ["//visibility:public"],
)

js_binary(
    name = "api_format",
    entry_point = "api-format.mjs",
    data = ["api-sync.mjs"],
)

js_run_binary(
    name = "api_generated",
    tool = ":api_format",
    srcs = ["//api:projection", ":cue", "//build/python:ruff", "//:pyproject.toml"],
    args = [
        "$(execpath //api:projection)",
        "$(RULEDIR)/api-files",
        "$(execpath :cue)",
        "$(execpath //build/python:ruff)",
        "$(execpath //:pyproject.toml)",
    ],
    out_dirs = ["api-files"],
    copy_srcs_to_bin = False,
    patch_node_fs = False,
    mnemonic = "APIFormat",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "api_sync",
    entry_point = "api-sync.mjs",
    args = ["$(rlocationpath :api_generated)"],
    data = [":api_generated"],
    patch_node_fs = False,
    visibility = ["//visibility:public"],
)

js_test(
    name = "api_check",
    entry_point = "api-sync.mjs",
    copy_data_to_bin = False,
    args = ["--check", "$(rlocationpath :api_generated)", "$(rlocationpath //api:generated.json)"],
    data = [":api_generated", "//:api_mirrors", "//api:generated.json"],
    visibility = ["//visibility:public"],
)
