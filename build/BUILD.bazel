cue_binary(
    name = "cue",
    visibility = ["//visibility:public"],
)

js_test(
    name = "embedding_atlas_consumer",
    entry_point = "npm-embedding-atlas-consumer.mjs",
    data = [
        ":npm_install_sources",
        "//:node_modules/embedding-atlas",
        "//:node_modules/jsdom",
        "//packages/mosaic/sql:tarball",
        "//packages/mosaic/core:tarball",
        "//packages/server/duckdb:tarball",
        "//packages/vgplot/inputs:tarball",
        "//packages/vgplot/plot:tarball",
        "//packages/vgplot/spec:tarball",
        "//packages/vgplot/vgplot:tarball",
        "//packages/mosaic/sql:node_modules/@polyglot-sql/sdk",
        "//packages/mosaic/core:node_modules/@duckdb/duckdb-wasm",
        "//packages/mosaic/core:node_modules/@types/emscripten",
        "//packages/mosaic/core:node_modules/@uwdata/flechette",
        "//packages/server/duckdb:node_modules/@duckdb/node-api",
        "//packages/vgplot/plot:node_modules/@observablehq/plot",
        "//packages/vgplot/plot:node_modules/d3",
        "@pnpm//:pnpm",
    ],
    env = {
        "MOSAIC_PACKAGES": json.encode({
            "@uwdata/mosaic-sql": "$(rlocationpath //packages/mosaic/sql:tarball)",
            "@uwdata/mosaic-core": "$(rlocationpath //packages/mosaic/core:tarball)",
            "@uwdata/mosaic-duckdb": "$(rlocationpath //packages/server/duckdb:tarball)",
            "@uwdata/mosaic-inputs": "$(rlocationpath //packages/vgplot/inputs:tarball)",
            "@uwdata/mosaic-plot": "$(rlocationpath //packages/vgplot/plot:tarball)",
            "@uwdata/mosaic-spec": "$(rlocationpath //packages/vgplot/spec:tarball)",
            "@uwdata/vgplot": "$(rlocationpath //packages/vgplot/vgplot:tarball)",
        }),
        "MOSAIC_LINKS": json.encode({
            "@polyglot-sql/sdk": "packages/mosaic/sql/node_modules/@polyglot-sql/sdk",
            "@duckdb/duckdb-wasm": "packages/mosaic/core/node_modules/@duckdb/duckdb-wasm",
            "@types/emscripten": "packages/mosaic/core/node_modules/@types/emscripten",
            "@uwdata/flechette": "packages/mosaic/core/node_modules/@uwdata/flechette",
            "@duckdb/node-api": "packages/server/duckdb/node_modules/@duckdb/node-api",
            "@observablehq/plot": "packages/vgplot/plot/node_modules/@observablehq/plot",
            "d3": "packages/vgplot/plot/node_modules/d3",
        }),
        "PNPM_BIN": "$(rlocationpath @pnpm//:pnpm)",
    },
    patch_node_fs = False,
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "cue_format",
    entry_point = "cue-format.mjs",
    args = ["$(rlocationpath :cue)"],
    data = [":cue", "//api:sources", "//api/catalog:sources"],
    copy_data_to_bin = False,
    visibility = ["//visibility:public"],
)

js_binary(
    name = "api_format",
    entry_point = "api-format.mjs",
    data = ["api-sync.mjs"],
)

js_run_binary(
    name = "api_generated",
    tool = ":api_format",
    srcs = ["//api:projection", ":cue", "//build/python:ruff", "//:pyproject.toml"],
    args = [
        "$(execpath //api:projection)",
        "$(RULEDIR)/api-files",
        "$(execpath :cue)",
        "$(execpath //build/python:ruff)",
        "$(execpath //:pyproject.toml)",
    ],
    out_dirs = ["api-files"],
    copy_srcs_to_bin = False,
    patch_node_fs = False,
    mnemonic = "APIFormat",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "api_sync",
    entry_point = "api-sync.mjs",
    args = ["$(rlocationpath :api_generated)"],
    data = [":api_generated"],
    patch_node_fs = False,
    visibility = ["//visibility:public"],
)

js_test(
    name = "api_check",
    entry_point = "api-sync.mjs",
    copy_data_to_bin = False,
    args = ["--check", "$(rlocationpath :api_generated)", "$(rlocationpath //api:generated.json)"],
    data = [":api_generated", "//:api_mirrors", "//api:generated.json"],
    visibility = ["//visibility:public"],
)
